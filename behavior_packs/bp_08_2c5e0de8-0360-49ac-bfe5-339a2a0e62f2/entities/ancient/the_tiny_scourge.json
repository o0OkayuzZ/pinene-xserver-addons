{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:the_tiny_scourge",
      "runtime_identifier": "minecraft:zombie",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "minecraft:is_riding_zombie_horse": {
          "client_sync": false,
          "default": false,
          "type": "bool"
        }
      },
      "spawn_category": "monster"
    },
    "components": {
      "minecraft:home": {
        "restriction_radius": 16,
        "restriction_type": "random_movement"
      },
      "minecraft:boss": {
        "name": "entity.dungeons:the_tiny_scourge.name",
        "hud_range": 16
      },
      "minecraft:knockback_resistance": {
        "value": 0.5,
        "max": 0.5
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:behavior.equip_item": {
        "priority": 2
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": [
          {
            "filters": [
              {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "breeze"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "necromancer"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient_minion"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient"
                  }
                ]
              }
            ]
          }
        ],
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 6,
        "priority": 8
      },
      "minecraft:behavior.melee_box_attack": {
        "can_spread_on_fire": true,
        "priority": 4
      },
      "minecraft:behavior.nearest_attackable_target": {
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 25,
        "must_see_forget_duration": 17,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "snowgolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "key_golem_target"
                }
              ]
            },
            "max_dist": 35
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "villager"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "wandering_trader"
                }
              ]
            },
            "max_dist": 35,
            "must_see": false
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "baby_turtle"
                },
                {
                  "test": "in_water",
                  "subject": "other",
                  "value": false
                }
              ]
            },
            "max_dist": 35
          }
        ],
        "priority": 2
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.stomp_turtle_egg": {
        "goal_radius": 1.14,
        "priority": 5,
        "search_height": 2,
        "interval": 20,
        "search_range": 10,
        "speed_multiplier": 1
      },
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "height": 1.9,
        "width": 0.6
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:persistent": {},
      "minecraft:environment_sensor": {
        "triggers": [
          // Keep these the same for each "minecraft:environment_sensor".
          {
            "event": "minecraft:on_start_riding_zombie_horse",
            "filters": {
              "all_of": [
                {
                  "test": "is_vehicle_family",
                  "value": "zombiehorse"
                },
                {
                  "domain": "minecraft:is_riding_zombie_horse",
                  "test": "bool_property",
                  "value": false
                }
              ]
            }
          },
          {
            "event": "minecraft:on_stop_riding_zombie_horse",
            "filters": {
              "all_of": [
                {
                  "operator": "not",
                  "test": "is_vehicle_family",
                  "value": "zombiehorse"
                },
                {
                  "domain": "minecraft:is_riding_zombie_horse",
                  "test": "bool_property"
                }
              ]
            }
          }
        ]
      },
      "minecraft:equip_item": {
        "excluded_items": [
          {
            "item": "minecraft:banner:15"
          }
        ]
      },
      "minecraft:health": {
        "max": 400,
        "value": 400
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "test": "in_lava"
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_break_doors": true,
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true
      },
      "minecraft:physics": {},
      "minecraft:rotation_locked_to_vehicle": {},
      "minecraft:type_family": {
        "family": [
          "dungeons_musicbox",
          "ancient",
          "boss",
          "enchanted",
          "zombie",
          "undead",
          "monster",
          "mob"
        ]
      }
    },
    "component_groups": {
      "minecraft:not_on_zombie_horse": {
        "minecraft:behavior.use_kinetic_weapon": {
          "approach_distance": 10,
          "reposition_distance": {
            "min": 6,
            "max": 7
          },
          "cooldown_distance": {
            "min": 9,
            "max": 11
          },
          "weapon_reach_multiplier": 0.5,
          "weapon_min_speed_multiplier": 0.2,
          "hijack_mount_navigation": true,
          "track_target": true,
          "priority": 3
        }
      },
      "minecraft:can_break_doors": {
        "minecraft:annotation.break_door": {}
      },
      "minecraft:on_zombie_horse": {
        "minecraft:behavior.use_kinetic_weapon": {
          "approach_distance": 12,
          "reposition_distance": {
            "min": 8,
            "max": 9
          },
          "reposition_speed_multiplier": 1.4,
          "cooldown_distance": {
            "min": 11,
            "max": 13
          },
          "cooldown_speed_multiplier": 1.4,
          "weapon_reach_multiplier": 0.5,
          "weapon_min_speed_multiplier": 0.2,
          "hijack_mount_navigation": true,
          "speed_multiplier": 1.4,
          "track_target": true,
          "priority": 3
        }
      },
      "minecraft:zombie_adult": {
        "minecraft:scale": {
          "value": 1.3
        },
        "minecraft:behavior.mount_pathing": {
          "priority": 2,
          "target_dist": 0,
          "speed_multiplier": 1.25,
          "track_target": true
        },
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 100 : 0"
        },
        "minecraft:movement": {
          "value": 0.23
        },
        "minecraft:rideable": {
          "family_types": ["baby_undead"],
          "seat_count": 1,
          "seats": {
            "lock_rider_rotation": 0,
            "position": [0, 1.175, -0.35]
          }
        },
        "minecraft:collision_box": {
          "height": 1.9,
          "width": 0.6
        }
      },
      "minecraft:zombie_baby": {
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 100 : 0"
        },
        "minecraft:is_baby": {},
        "minecraft:movement": {
          "value": 0.35
        },
        "minecraft:scale": {
          "value": 0.65
        },
        "minecraft:collision_box": {
          "height": 1.96, // 0.98/0.5
          "width": 0.98 // 0.49/0.5
        },
        "minecraft:type_family": {
          "family": [
            "dungeons_musicbox",
            "ancient",
            "boss",
            "enchanted",
            "baby_undead",
            "zombie",
            "undead",
            "monster",
            "mob"
          ]
        }
      },
      "minecraft:zombie_default": {
        "minecraft:loot": {
          "table": "loot_tables/entities/zombie.json"
        }
      },
      "minecraft:zombie_jockey": {
        "minecraft:behavior.find_mount": {
          "max_failed_attempts": 20,
          "priority": 1,
          "start_delay": 15,
          "within_radius": 16
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/zombie.json"
        }
      },
      "minecraft:zombie_rider": {
        "minecraft:equipment": {
          "table": "loot_tables/entities/zombie_rider_equipment.json"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/zombie_rider.json"
        },
        "minecraft:type_family": {
          "family": [
            "dungeons_musicbox",
            "ancient",
            "boss",
            "enchanted",
            "zombie_rider",
            "zombie",
            "undead",
            "monster",
            "mob"
          ]
        }
      }
    },
    "events": {
      "minecraft:on_stop_riding_zombie_horse": {
        "add": {
          "component_groups": ["minecraft:not_on_zombie_horse"]
        },
        "set_property": {
          "minecraft:is_riding_zombie_horse": false
        },
        "remove": {
          "component_groups": ["minecraft:on_zombie_horse"]
        }
      },
      "minecraft:spawn_as_rider": {
        "queue_command": {
          "command": ["ride @s start_riding @n[r=2,type=zombie_horse]"]
        },
        "add": {
          "component_groups": [
            "minecraft:zombie_adult",
            "minecraft:zombie_rider",
            // On Vanilla riders always spawn on Zombie Horses, but if
            // it is not the case this will fix itself next tick.
            "minecraft:on_zombie_horse"
          ]
        },
        "set_property": {
          "minecraft:is_riding_zombie_horse": true
        }
      },
      "minecraft:as_baby": {
        "add": {
          "component_groups": [
            "minecraft:zombie_default",
            "minecraft:zombie_baby",
            "minecraft:not_on_zombie_horse"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "trigger": "minecraft:as_baby"
          },
          {
            "randomize": [
              {
                "add": {
                  "component_groups": ["minecraft:can_break_doors"]
                },
                "weight": 10
              },
              {
                "weight": 90
              }
            ]
          }
        ]
      },
      "minecraft:on_start_riding_zombie_horse": {
        "add": {
          "component_groups": ["minecraft:on_zombie_horse"]
        },
        "set_property": {
          "minecraft:is_riding_zombie_horse": true
        },
        "remove": {
          "component_groups": ["minecraft:not_on_zombie_horse"]
        }
      }
    }
  }
}
