{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
        "identifier": "dungeons:unstoppable_tusk_minion",
      "runtime_identifier": "minecraft:piglin",
      "spawn_category": "monster",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "dungeons:red_coat": {
        "minecraft:mark_variant": {
          "value": 1
        },
        "minecraft:health": {
          "value": 48,
          "max": 48
        }
      },
      "dungeons:blue_coat": {
        "minecraft:mark_variant": {
          "value": 2
        },
        "minecraft:health": {
          "value": 48,
          "max": 48
        }
      },
      "zombification_sensor": {
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "all_of": [
                {
                  "test": "in_nether",
                  "value": false
                },
                {
                  "test": "has_tag",
                  "value": "dungeons:ancient_hunt",
                  "subject": "self",
                  "operator": "not"
                }
              ]
            },
            "event": "start_zombification_event"
          }
        }
      },
      "start_zombification": {
        "minecraft:is_shaking": {},
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "any_of": [
                {
                  "test": "in_nether",
                  "value": true
                },
                {
                  "test": "has_tag",
                  "value": "dungeons:ancient_hunt",
                  "subject": "self"
                }
              ]
            },
            "event": "stop_zombification_event"
          }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 15,
          "time_down_event": {
            "event": "become_zombie_event"
          }
        }
      },
      "become_zombie": {
        "minecraft:transformation": {
          "into": "minecraft:zombie_pigman",
          "transformation_sound": "converted_to_zombified",
          "keep_level": true,
          "drop_inventory": true,
          "preserve_equipment": true
        }
      },
      "ranged_unit": {
        "minecraft:behavior.ranged_attack": {
          "priority": 8,
          "attack_interval_min": 1,
          "attack_interval_max": 1,
          "attack_radius": 8,
          "attack_radius_min": 4,
          "speed_multiplier": 1.0,
          "target_in_sight_time": 0.1
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow"
        },
        "minecraft:behavior.charge_held_item": {
          "priority": 3,
          "items": [
            "minecraft:arrow"
          ]
        },
        "minecraft:equipment": {
          "table": "loot_tables/entities/piglin_gear_ranged.json"
        },
        "minecraft:variant": {
          "value": 0
        }
      },
      "melee_unit": {
        "minecraft:behavior.melee_box_attack": {
          "priority": 8,
          "speed_multiplier": 1.0,
          "track_target": true
        },
        "minecraft:attack": {
          "damage": 5
        },
        "minecraft:equipment": {
          "table": "loot_tables/entities/piglin_gear_melee.json"
        },
        "minecraft:variant": {
          "value": 1
        }
      },
      "angry": {
        "minecraft:angry": {
          "duration": 30,
          "broadcast_anger": true,
          "broadcast_anger_on_attack": true,
          "broadcast_anger_on_being_attacked": true,
          "broadcast_range": 16,
          "broadcast_targets": [
            "piglin" // we want to broadcast to both normal piglins and piglin_brute
          ],
          "calm_event": {
            "event": "become_calm_event",
            "target": "self"
          },
          "filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "piglin"
              },
              {
                "test": "has_component",
                "subject": "self",
                "operator": "!=",
                "value": "minecraft:attack_cooldown"
              }
            ]
          },
          "angry_sound": "angry",
          "sound_interval": {
            "range_min": 2.0,
            "range_max": 5.0
          }
        }
      },
      "attack_cooldown": {
        "minecraft:attack_cooldown": {
          "attack_cooldown_time": [
            30.0,
            120.0
          ],
          "attack_cooldown_complete_event": {
            "event": "attack_cooldown_complete_event",
            "target": "self"
          }
        }
      },
      "piglin_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.55
        },
        "minecraft:collision_box": {
          "height": 1.96, // 0.98/0.5
          "width": 0.98 // 0.49/0.5
        },
        "minecraft:movement": {
          "value": 0.42
        },
        "minecraft:behavior.panic": {
          "priority": 1,
          "speed_multiplier": 1.1
        }
      },
      "piglin_adult": {
        "minecraft:movement": {
          "value": 0.35
        }
      },
      "interactable_piglin": {
      },
      "hunter": {
        "minecraft:type_family": {
          "family": [
            "ancient_minion",
            "enchanted",
            "piglin",
            "piglin_hunter",
            "monster"
          ]
        }
      },
      "not_hunter": {
        "minecraft:type_family": {
          "family": [
            "ancient_minion",
            "enchanted",
            "piglin",
            "monster"
          ]
        }
      },
      "alert_for_attack_targets": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 7,
          "within_radius": 16,
          "persist_time": 2,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "wither"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "key_golem_target"
                  }
                ]
              },
              "max_dist": 16
            },
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "self",
                    "value": "piglin_hunter"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "hoglin_huntable"
                  },
                  {
                    "test": "has_component",
                    "subject": "other",
                    "operator": "!=",
                    "value": "minecraft:is_baby"
                  },
                  {
                    "test": "has_component",
                    "subject": "self",
                    "operator": "!=",
                    "value": "minecraft:attack_cooldown"
                  }
                ]
              },
              "max_dist": 16
            },
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_tag",
                    "subject": "other",
                    "operator": "!=",
                    "value": "origins:mob_piglin_neutral"
                  }
                ]
              },
              "max_dist": 16
            },
            {
              "filters": {
                "test": "has_tag",
                "subject": "other",
                "value": "origins:mob_piglin_attack_on_sight"
              },
              "max_dist": 16
            },
            {
              "filters": {
                "any_of": [
                  {
                    "test": "has_container_open",
                    "subject": "other",
                    "operator": "==",
                    "value": true
                  }
                ]
              },
              "max_dist": 16
            }
          ],
          "must_see": true
        }
      },
      "take_target_as_response_to_block_break": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 7,
          "entity_types": [
            {
              "filters": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "origins:mob_piglin_neutral"
                }
              ],
              "max_dist": 16
            }
          ]
        }
      },
      "piglin_jockey": {
        "minecraft:behavior.find_mount": {
          "priority": 1,
          "within_radius": 16,
          "start_delay": 15,
          "max_failed_attempts": 20
        }
      }
    },
    "components": {
                            "minecraft:home": {
                "restriction_radius": 16,
                "restriction_type": "random_movement"
            },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:on_target_acquired": {
        "event": "become_angry_event",
        "target": "self"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:health": {
        "value": 32,
        "max": 32
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_open_doors": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:nameable": {},
      "minecraft:behavior.hurt_by_target": {
                                "entity_types": [
                    {
                        "filters": [
                            {
                                "all_of": [
                                    {
                                        "operator": "not",
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "ancient_minion"
                                    },
                                    {
                                        "operator": "not",
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "ancient"
                                    }
                                ]
                            }
                        ]
                    }
                ],
        "priority": 1
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.random_stroll": {
        "priority": 10,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 11,
        "look_distance": 8
      },
      "minecraft:knockback_resistance": {
        "value": 0.2,
        "max": 0.2
      },
      "minecraft:scale": {
        "value": 1.1
      },
      "minecraft:behavior.random_look_around": {
        "priority": 12
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:follow_range": {
        "value": 64
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "trigger": "spawn_adult_ranged_no_hunting"
      },
      "minecraft:entity_born": {
        "trigger": "spawn_baby"
      },
      "spawn_adult_no_hunting": {
        "randomize": [
          {
            "weight": 1,
            "trigger": "spawn_adult_ranged_no_hunting"
          },
          {
            "weight": 1,
            "trigger": "spawn_adult_melee_no_hunting"
          }
        ]
      },
      "spawn_adult": {
        "randomize": [
          {
            "weight": 1,
            "trigger": "spawn_adult_blue_ranged"
          },
          {
            "weight": 1,
            "trigger": "spawn_adult_red_melee"
          },
          {
            "weight": 3,
            "trigger": "spawn_adult_ranged"
          },
          {
            "weight": 3,
            "trigger": "spawn_adult_melee"
          }
        ]
      },
      "spawn_adult_blue_ranged": {
        "add": {
          "component_groups": [
            "dungeons:blue_coat",
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "ranged_unit",
            "attack_cooldown",
            "hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_adult_ranged": {
        "add": {
          "component_groups": [
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "ranged_unit",
            "attack_cooldown",
            "hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_adult_ranged_no_hunting": {
        "add": {
          "component_groups": [
            "dungeons:blue_coat",
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "ranged_unit",
            "attack_cooldown",
            "not_hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_adult_red_melee": {
        "add": {
          "component_groups": [
            "dungeons:red_coat",
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "melee_unit",
            "attack_cooldown",
            "hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_adult_melee": {
        "add": {
          "component_groups": [
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "melee_unit",
            "attack_cooldown",
            "hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_adult_melee_no_hunting": {
        "add": {
          "component_groups": [
            "piglin_adult",
            "zombification_sensor",
            "alert_for_attack_targets",
            "melee_unit",
            "attack_cooldown",
            "not_hunter",
            "interactable_piglin"
          ]
        }
      },
      "spawn_baby": {
        "randomize": [
          {
            "weight": 9,
            "add": {
              "component_groups": [
                "piglin_baby",
                "zombification_sensor",
                "not_hunter"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "piglin_baby",
                "zombification_sensor",
                "piglin_jockey",
                "not_hunter"
              ]
            }
          }
        ]
      },
      "stop_zombification_event": {
        "add": {
          "component_groups": [
            "zombification_sensor"
          ]
        },
        "remove": {
          "component_groups": [
            "start_zombification"
          ]
        }
      },
      "start_zombification_event": {
        "add": {
          "component_groups": [
            "start_zombification"
          ]
        },
        "remove": {
          "component_groups": [
            "zombification_sensor"
          ]
        }
      },
      "become_angry_event": {
        "add": {
          "component_groups": [
            "angry"
          ]
        }
      },
      "become_calm_event": {
        "remove": {
          "component_groups": [
            "angry",
            "take_target_as_response_to_block_break"
          ]
        },
        "add": {
          "component_groups": [
            "alert_for_attack_targets",
            "attack_cooldown"
          ]
        }
      },
      "attack_cooldown_complete_event": {
        "remove": {
          "component_groups": [
            "attack_cooldown"
          ]
        }
      },
      "become_zombie_event": {
        "add": {
          "component_groups": [
            "become_zombie"
          ]
        }
      },
      "important_block_destroyed_event": {
        "remove": {
          "component_groups": [
            "alert_for_attack_targets"
          ]
        },
        "add": {
          "component_groups": [
            "take_target_as_response_to_block_break"
          ]
        }
      },
      "admire_item_started_event": {
        "remove": {
          "component_groups": [
            "interactable_piglin"
          ]
        }
      },
      "admire_item_stopped_event": {
        "add": {
          "component_groups": [
            "interactable_piglin"
          ]
        }
      }
    }
  }
}