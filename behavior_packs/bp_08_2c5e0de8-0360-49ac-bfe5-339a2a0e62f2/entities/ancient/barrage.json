{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:barrage",
      "runtime_identifier": "minecraft:skeleton",
      "is_summonable": true,
      "is_spawnable": false,
      "spawn_category": "monster"
    },
    "components": {
      "minecraft:boss": {
        "name": "entity.dungeons:barrage.name",
        "hud_range": 16
      },
      "minecraft:home": {
        "restriction_radius": 16,
        "restriction_type": "random_movement"
      },
      "minecraft:scale": {
        "value": 1.3
      },
      "minecraft:knockback_resistance": {
        "value": 0.5,
        "max": 0.5
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": [
          {
            "filters": [
              {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient_minion"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "breeze"
                  }
                ]
              }
            ]
          }
        ],
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7
      },
      "minecraft:behavior.nearest_attackable_target": {
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 32,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            }
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "irongolem"
            }
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "baby_turtle"
                },
                {
                  "test": "in_water",
                  "subject": "other",
                  "value": false
                }
              ]
            }
          }
        ],
        "priority": 2
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.ranged_attack": {
        //rapid fire
        "attack_interval_max": 1.0,
        "attack_interval_min": 1.0,
        "attack_radius": 24.0,
        "priority": 0
      },
      "minecraft:breathable": {
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "height": 1.9,
        "width": 0.6
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:persistent": {},
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "event": "minecraft:melee_mode",
            "filters": {
              "test": "is_underwater"
            }
          },
          {
            "event": "minecraft:melee_mode",
            "filters": {
              "test": "has_ranged_weapon",
              "value": false
            }
          }
        ]
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/skeleton_gear.json",
        "slot_drop_chance": [
          {
            "slot": "slot.weapon.mainhand",
            "drop_chance": -1
          },
          {
            "slot": "slot.armor.head",
            "drop_chance": -1
          },
          {
            "slot": "slot.armor.chest",
            "drop_chance": -1
          }
        ]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 100 : 0"
      },
      "minecraft:health": {
        "max": 400,
        "value": 400
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "test": "in_lava"
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/skeleton.json"
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "avoid_sun": true,
        "is_amphibious": true,
        "avoid_water": true
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_block": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:rotation_locked_to_vehicle": {},
      "minecraft:shooter": {
        "def": "minecraft:arrow"
      },
      "minecraft:type_family": {
        "family": [
          "boss",
          "ancient",
          "dungeons_musicbox",
          "enchanted",
          "skeleton",
          "undead",
          "monster",
          "mob"
        ]
      }
    },
    "component_groups": {
      "minecraft:melee_attack": {
        "minecraft:attack": {
          "damage": 2
        },
        "minecraft:behavior.melee_box_attack": {
          "speed_multiplier": 1.25,
          "track_target": true,
          "priority": 4
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "event": "minecraft:ranged_mode",
              "filters": {
                "all_of": [
                  {
                    "test": "in_water",
                    "value": false
                  },
                  {
                    "test": "has_ranged_weapon"
                  }
                ]
              }
            }
          ]
        }
      },
      "minecraft:ranged_attack": {
        "minecraft:behavior.ranged_attack": {
          //rapid fire
          "attack_interval_max": 1.0,
          "attack_interval_min": 1.0,
          "attack_radius": 24.0,
          "priority": 0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "event": "minecraft:melee_mode",
              "filters": {
                "test": "is_underwater"
              }
            },
            {
              "event": "minecraft:melee_mode",
              "filters": {
                "test": "has_ranged_weapon",
                "value": false
              }
            }
          ]
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow",
          "sound": "bow"
        }
      },
      "minecraft:ranged_attack_hard": {
        "minecraft:behavior.ranged_attack": {
          //rapid fire
          "attack_interval_max": 1.0,
          "attack_interval_min": 1.0,
          "attack_radius": 24.0,
          "priority": 0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "event": "minecraft:melee_mode",
              "filters": {
                "test": "is_underwater"
              }
            },
            {
              "event": "minecraft:melee_mode",
              "filters": {
                "test": "has_ranged_weapon",
                "value": false
              }
            }
          ]
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow",
          "sound": "bow"
        }
      }
    },
    "events": {
      "minecraft:switch_to_hard_ranged": {
        "add": {
          "component_groups": ["minecraft:ranged_attack_hard"]
        },
        "remove": {
          "component_groups": ["minecraft:ranged_attack"]
        }
      },
      "minecraft:switch_to_normal_ranged": {
        "add": {
          "component_groups": ["minecraft:ranged_attack"]
        },
        "remove": {
          "component_groups": ["minecraft:ranged_attack_hard"]
        }
      },
      "minecraft:melee_mode": {
        "add": {
          "component_groups": ["minecraft:melee_attack"]
        },
        "remove": {
          "component_groups": [
            "minecraft:ranged_attack",
            "minecraft:ranged_attack_hard"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "filters": {
              "test": "is_difficulty",
              "value": "hard"
            },
            "add": {
              "component_groups": ["minecraft:ranged_attack_hard"]
            }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "operator": "!=",
              "value": "hard"
            },
            "add": {
              "component_groups": ["minecraft:ranged_attack"]
            }
          }
        ]
      },
      "minecraft:ranged_mode": {
        "sequence": [
          {
            "filters": {
              "test": "is_difficulty",
              "value": "hard"
            },
            "add": {
              "component_groups": ["minecraft:ranged_attack_hard"]
            },
            "remove": {
              "component_groups": [
                "minecraft:melee_attack",
                "minecraft:ranged_attack"
              ]
            }
          },
          {
            "filters": {
              "test": "is_difficulty",
              "operator": "!=",
              "value": "hard"
            },
            "add": {
              "component_groups": ["minecraft:ranged_attack"]
            },
            "remove": {
              "component_groups": [
                "minecraft:melee_attack",
                "minecraft:ranged_attack_hard"
              ]
            }
          }
        ]
      }
    }
  }
}
