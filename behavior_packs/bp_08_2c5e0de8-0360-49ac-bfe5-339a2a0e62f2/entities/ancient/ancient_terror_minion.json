{
  "format_version": "1.21.130",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:ancient_terror_minion",
      "runtime_identifier": "minecraft:spider",
      "spawn_category": "monster",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "minecraft:spider_hostile": {
        "minecraft:on_target_acquired": {
          "event": "minecraft:become_angry"
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "attack_interval": 5,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "snowgolem"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "irongolem"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "key_golem_target"
                  }
                ]
              },
              "max_dist": 32
            }
          ]
        }
      },
      "minecraft:spider_angry": {
        "minecraft:angry": {
          "duration": 10,
          "duration_delta": 3,
          "calm_event": {
            "event": "minecraft:become_calm",
            "target": "self"
          }
        },
        "minecraft:behavior.leap_at_target": {
          "priority": 4,
          "yd": 0.4,
          "must_be_on_ground": false
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3,
          "track_target": true
        }
      }
    },
    "components": {
      "minecraft:home": {
        "restriction_radius": 16,
        "restriction_type": "random_movement"
      },
      "minecraft:scale": {
        "value": 1.1
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:renders_when_invisible": {},
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": [
          "ancient_minion",
          "enchanted",
          "spider",
          "monster",
          "mob",
          "arthropod"
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 0.9
      },
      "minecraft:health": {
        "value": 32,
        "max": 32
      },
      "minecraft:knockback_resistance": {
        "value": 0.2,
        "max": 0.2
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.climb": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:attack": {
        "damage": 2
      },
      "minecraft:behavior.float": {
        "priority": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": [
              {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient_minion"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "breeze"
                  }
                ]
              }
            ]
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "dungeons:spawn_normal": {
        "add": {
          "component_groups": ["minecraft:spider_hostile"]
        }
      },
      "minecraft:entity_spawned": {
        "trigger": "dungeons:spawn_normal"
      },
      "minecraft:become_angry": {
        "add": {
          "component_groups": ["minecraft:spider_angry"]
        }
      },
      "minecraft:become_calm": {
        "remove": {
          "component_groups": ["minecraft:spider_angry"]
        }
      }
    }
  }
}
