{
    "format_version": "1.21.130",
    "minecraft:entity": {
        "description": {
            "identifier": "dungeons:thundering_growth",
            "runtime_identifier": "vindicator", //using a hostile mob RTI prevents them appearing in peaceful - afaik the Vindicator RTi doesn't do anything, so it is safe to use without affecting mob behaviour
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "dungeons:instant_despawn": {
                "minecraft:instant_despawn": {}
            },
            "dungeons:standard_despawn": {
                "minecraft:behavior.nearest_attackable_target": {
                    "priority": 2,
                    "must_see": true,
                    "reselect_targets": true,
                    "within_radius": 25.0,
                    "must_see_forget_duration": 17.0,
                    "entity_types": [
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "player"
                                    },
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "snowgolem"
                                    },
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "irongolem"
                                    },
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "key_golem_target"
                                    }
                                ]
                            },
                            "max_dist": 32
                        }
                    ]
                },
                "minecraft:experience_reward": {
                    "on_death": "query.last_hit_by_player ? 100 : 0"
                }
            },
            "dungeons:hostile": {
                "minecraft:ravager_blocked": {
                    "knockback_strength": 2.5,
                    "reaction_choices": [
                        {
                            "weight": 1,
                            "value": {
                                "event": "dungeons:become_stunned",
                                "target": "self"
                            }
                        }
                    ]
                },
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "track_target": true,
                    "require_complete_path": false,
                    "random_stop_interval": 0,
                    "reach_multiplier": 1.95,
                    "cooldown_time": 0.05,
                    "speed_multiplier": 1.3,
                    "attack_duration": 1,
                    "hit_delay_pct": 0.65
                }
            },
            "dungeons:passive": {
                "minecraft:behavior.delayed_attack": {
                    "priority": 3,
                    "track_target": true,
                    "require_complete_path": false,
                    "random_stop_interval": 0,
                    "reach_multiplier": 0.0,
                    "cooldown_time": 0.05,
                    "speed_multiplier": 0.0,
                    "attack_duration": 90,
                    "hit_delay_pct": 0.65
                }
            },
            "dungeons:stun_timer": {
                "minecraft:is_stunned": {},
                "minecraft:behavior.timer_flag_2": {
                    "priority": 0,
                    "cooldown_range": 0,
                    "duration_range": [
                        2.5,
                        2.5
                    ],
                    "on_end": {
                        "event": "dungeons:end_stunned",
                        "target": "self"
                    }
                }
            },
            "dungeons:roar_ready": {
                "minecraft:on_target_acquired": {
                    "event": "dungeons:roar_start",
                    "target": "self"
                }
            },
            "dungeons:roar_cooldown": {
                "minecraft:attack_cooldown": {
                    "attack_cooldown_time": 10,
                    "attack_cooldown_complete_event": {
                        "event": "dungeons:end_roar_cooldown",
                        "target": "self"
                    }
                }
            },
            "dungeons:roaring": {
                "minecraft:behavior.timer_flag_1": {
                    "priority": 0,
                    "cooldown_range": 0,
                    "duration_range": [
                        1.2083,
                        1.2083
                    ],
                    "on_end": {
                        "event": "dungeons:roar_end",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:boss": {
                "name": "entity.dungeons:thundering_growth.name",
                "hud_range": 16
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:attack": {
                "damage": 7
            },
            "minecraft:scale": {
                "value": 1.3
            },
            "minecraft:breathable": {
                "suffocate_time": 0,
                "total_supply": 15
            },
            "minecraft:collision_box": {
                "height": 2,
                "width": 2.1
            },
            "minecraft:health": {
                "max": 120,
                "value": 1200
            },
            "minecraft:jump.static": {},
            "minecraft:loot": {
                "table": "loot_tables/entities/leapleaf.json"
            },
            "minecraft:knockback_resistance": {
                "value": 1.0
            },
            "minecraft:movement": {
                "value": 0.27
            },
            "minecraft:movement.basic": {},
            "minecraft:nameable": {},
            "minecraft:navigation.walk": {
                "avoid_damage_blocks": false,
                "can_path_over_water": false,
                "can_sink": true
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "speed_multiplier": 1
            },
            "minecraft:behavior.look_at_player": {
                "priority": 8,
                "look_distance": 6,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:persistent": {},
            "minecraft:home": {
                "restriction_type": "random_movement",
                "restriction_radius": 16
            },
            "minecraft:behavior.hurt_by_target": {
                "entity_types": [
                    {
                        "filters": [
                            {
                                "all_of": [
                                    {
                                        "operator": "not",
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "ancient_minion"
                                    },
                                    {
                                        "operator": "not",
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "ancient"
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "priority": 1
            },
            "minecraft:equipment": {
                "table": "loot_tables/entities/leapleaf_axe.json", //used for shield break effect
                "slot_drop_chance": [
                    {
                        "slot": "slot.weapon.mainhand",
                        "drop_chance": -1
                    }
                ]
            },
            "minecraft:conditional_bandwidth_optimization": {},
            //deflect
            "minecraft:reflect_projectiles": {
                "reflected_projectiles": [
                    "xp_bottle",
                    "thrown_trident",
                    "shulker_bullet",
                    "dragon_fireball",
                    "arrow",
                    "snowball",
                    "egg",
                    "fireball",
                    "splash_potion",
                    "ender_pearl",
                    "wither_skull",
                    "wither_skull_dangerous",
                    "small_fireball",
                    "lingering_potion",
                    "llama_spit",
                    "fireworks_rocket",
                    "fishing_hook"
                ],
                "azimuth_angle": "180.0 + Math.random(-3.0, 3.0)",
                "reflection_scale": "1.0"
            },
            "minecraft:follow_range": {
                "value": 127
            },
            "minecraft:type_family": {
                "family": [
                    "dungeons_musicbox",
                    "boss",
                    "ancient",
                    "enchanted",
                    "monster",
                    "leapleaf",
                    "mob"
                ]
            }
        },
        "events": {
            "dungeons:instant_despawn": {
                "add": {
                    "component_groups": [
                        "dungeons:instant_despawn"
                    ]
                },
                "queue_command": {
                    "command": [
                        "particle dungeons:vanguard_despawn"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "dungeons:roar_ready",
                        "dungeons:hostile",
                        "dungeons:standard_despawn"
                    ]
                }
            },
            "dungeons:abomination_minion": {
                "add": {
                    "component_groups": [
                        "dungeons:roar_ready",
                        "dungeons:hostile",
                        "dungeons:abomination_despawn"
                    ]
                }
            },
            "dungeons:end_roar_cooldown": {
                "add": {
                    "component_groups": [
                        "dungeons:roar_ready"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "dungeons:roar_cooldown"
                    ]
                }
            },
            "dungeons:roar_start": {
                "add": {
                    "component_groups": [
                        "dungeons:roaring",
                        "dungeons:passive"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "dungeons:roar_ready",
                        "dungeons:hostile"
                    ]
                },
                "queue_command": {
                    "command": [
                        "playsound mob.leapleaf.charge @a ~~~ 1.5 1.0"
                    ]
                }
            },
            "dungeons:roar_end": {
                "add": {
                    "component_groups": [
                        "dungeons:roar_cooldown",
                        "dungeons:hostile"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "dungeons:roaring",
                        "dungeons:passive"
                    ]
                },
                "queue_command": {
                    "command": [
                        "effect @s speed 7 1 true",
                        "effect @s strength 7 0 true"
                    ]
                }
            },
            "dungeons:become_stunned": {
                "add": {
                    "component_groups": [
                        "dungeons:passive",
                        "dungeons:stun_timer"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "dungeons:hostile"
                    ]
                },
                "queue_command": {
                    "command": [
                        "particle dungeons:leapleaf_smoke ~~~"
                    ]
                }
            },
            "dungeons:end_stunned": {
                "remove": {
                    "component_groups": [
                        "dungeons:passive",
                        "dungeons:stun_timer"
                    ]
                },
                "add": {
                    "component_groups": [
                        "dungeons:hostile"
                    ]
                }
            }
        }
    }
}