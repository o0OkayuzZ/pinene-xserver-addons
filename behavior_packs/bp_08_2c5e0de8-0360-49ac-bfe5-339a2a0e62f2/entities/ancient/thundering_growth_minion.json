                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "player"
                                    },
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "snowgolem"
                                    },
                                    {
                                        "test": "is_family",
                                        "subject": "other",
                                        "value": "irongolem"
                                    }
                                ]
