      },
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:type_family": {
        "family": ["enchanted", "boss", "ancient", "dungeons_musicbox", "geomancer", "monster", "illager", "mob"]
      }
    }
