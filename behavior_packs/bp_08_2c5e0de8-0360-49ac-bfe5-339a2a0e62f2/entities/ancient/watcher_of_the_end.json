{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:watcher_of_the_end",
      "runtime_identifier": "vindicator", //using a hostile mob RTI prevents them appearing in peaceful - afaik the Vindicator RTi doesn't do anything, so it is safe to use without affecting mob behaviour
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "dungeons:watchling_normal": {
        //deflect
        "minecraft:reflect_projectiles": {
          "reflected_projectiles": [
            "xp_bottle",
            "thrown_trident",
            "shulker_bullet",
            "dragon_fireball",
            "arrow",
            "snowball",
            "egg",
            "fireball",
            "splash_potion",
            "ender_pearl",
            "wither_skull",
            "wither_skull_dangerous",
            "small_fireball",
            "lingering_potion",
            "llama_spit",
            "fireworks_rocket",
            "fishing_hook"
          ],
          "azimuth_angle": "180.0 + Math.random(-3.0, 3.0)",
          "reflection_scale": "1.0"
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": [
                  {
                    "test": "has_tag",
                    "value": "dungeons:watchling_immune"
                  }
                ]
              },
              "cause": "all",
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "mob"
                    }
                  ]
                },
                "event": "dungeons:try_teleport"
              },
              "deals_damage": true
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    }
                  ]
                },
                "event": "dungeons:try_teleport"
              },
              "deals_damage": true
            }
          ]
        },
        "minecraft:collision_box": {
          "width": 0.7,
          "height": 2.4
        },
        "minecraft:knockback_resistance": {
          "value": 0.5
        },
        "minecraft:scale": {
          "value": 1.3
        },
        "minecraft:type_family": {
          "family": [
            "boss",
            "dungeons_musicbox",
            "ancient",
            "enchanted",
            "enderling",
            "monster",
            "watchling",
            "mob"
          ]
        },
        "minecraft:movement": {
          "value": 0.285
        },
        "minecraft:behavior.delayed_attack": {
          "priority": 2,
          "track_target": true,
          "require_complete_path": false,
          "random_stop_interval": 0,
          "reach_multiplier": 2.8,
          "cooldown_time": 0.1,
          "speed_multiplier": 1.04,
          "attack_duration": 1.2,
          "hit_delay_pct": 0.25
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 100 : 0"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/watchling.json"
      },
      "minecraft:health": {
        "value": 600,
        "max": 600
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          },
          {
            "filters": {
              "test": "in_contact_with_water",
              "operator": "==",
              "value": true
            },
            "cause": "drowning",
            "damage_per_tick": 1
          }
        ]
      },
      "minecraft:attack": {
        "damage": 7
      },

      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "attack_interval": 0,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "any_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "snowgolem"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "irongolem"
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "key_golem_target"
                    }
                  ]
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "operator": "!=",
                  "value": "dungeons:cutscene"
                }
              ]
            },
            "max_dist": 32
          }
        ]
      },
      "minecraft:boss": {
        "name": "entity.dungeons:watcher_of_the_end.name",
        "hud_range": 16
      },
      "minecraft:home": {
        "restriction_radius": 16,
        "restriction_type": "random_movement"
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": [
          {
            "filters": [
              {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient_minion"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient"
                  }
                ]
              }
            ]
          }
        ],
        "priority": 3
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:variable_max_auto_step": {
        "base_value": 1.0625,
        "jump_prevented_value": 0.5625
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["dungeons:watchling_normal"]
        }
      },
      "dungeons:try_teleport": {}
    }
  }
}
