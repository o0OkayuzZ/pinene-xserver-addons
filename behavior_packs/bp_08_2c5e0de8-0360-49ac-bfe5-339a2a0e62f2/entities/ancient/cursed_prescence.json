{
  "format_version": "1.21.130",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:cursed_presence",
      "runtime_identifier": "minecraft:skeleton",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "dungeons:standard_despawn": {
        "minecraft:despawn": {
          "despawn_from_distance": {}
        },
        "minecraft:experience_reward": {
          "on_death": "query.last_hit_by_player ? 100 : 0"
        }
      },
      "dungeons:has_shield": {
        "minecraft:is_saddled": {},
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "mob"
                    }
                  ]
                },
                "event": "dungeons:break_shield"
              },
              "deals_damage": "no"
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    }
                  ]
                },
                "event": "dungeons:break_shield"
              },
              "deals_damage": "no"
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "artefact"
                    }
                  ]
                },
                "event": "dungeons:break_shield"
              },
              "deals_damage": "no"
            }
          ]
        },
        "minecraft:knockback_resistance": {
          "value": 1
        }
      },
      "dungeons:no_shield": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "nameless_one"
                    }
                  ]
                }
              },
              "deals_damage": "no"
            }
          ]
        },
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      }
    },
    "components": {
      "minecraft:boss": {
        "name": "entity.dungeons:cursed_presence.name",
        "hud_range": 16
      },
      "minecraft:home": {
        "restriction_radius": 16,
        "restriction_type": "random_movement"
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/vanguard.json"
      },
      "minecraft:nameable": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:health": {
        "value": 480,
        "max": 480
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/vanguard_gear.json",
        "slot_drop_chance": [
          {
            "slot": "slot.weapon.mainhand",
            "drop_chance": 0.01
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "avoid_sun": false,
        "avoid_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:behavior.hurt_by_target": {
        "entity_types": [
          {
            "filters": [
              {
                "all_of": [
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient_minion"
                  },
                  {
                    "operator": "not",
                    "test": "is_family",
                    "subject": "other",
                    "value": "ancient"
                  }
                ]
              }
            ]
          }
        ],
        "priority": 1
      },
      "minecraft:behavior.delayed_attack": {
        "priority": 3,
        "track_target": true,
        "require_complete_path": false,
        "random_stop_interval": 0,
        "reach_multiplier": 6.5,
        "cooldown_time": 0.1,
        "speed_multiplier": 1.15,
        "attack_duration": 0.83,
        "hit_delay_pct": 0.6
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "reselect_targets": true,
        "must_see": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "key_golem_target"
            },
            "max_dist": 32
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 32
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "irongolem"
            },
            "max_dist": 32
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "baby_turtle"
                },
                {
                  "test": "in_water",
                  "subject": "other",
                  "operator": "!=",
                  "value": true
                }
              ]
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:scale": {
        "value": 1.3
      },
      "minecraft:type_family": {
        "family": [
          "ancient",
          "boss",
          "dungeons:music_box",
          "enchanted",
          "vanguard",
          "monster",
          "undead",
          "skeleton",
          "mob"
        ]
      },
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "dungeons:has_shield",
            "dungeons:standard_despawn"
          ]
        }
      },
      "dungeons:break_shield": {
        "add": {
          "component_groups": ["dungeons:no_shield"]
        },
        "remove": {
          "component_groups": ["dungeons:has_shield"]
        },
        "queue_command": {
          "command": [
            "playsound item.shield.block @a ~~~ 1.0 1.0",
            "playsound random.break @a ~~~ 0.3 1.0"
          ]
        }
      }
    }
  }
}
