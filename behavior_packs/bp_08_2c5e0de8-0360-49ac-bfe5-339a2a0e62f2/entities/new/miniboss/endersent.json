		"events": {
			"dungeons:bossbar_normal": {
				"add": {
					"component_groups": [
						"dungeons:bossbar_normal"
					]
				},
				"remove": {
					"component_groups": [
						"dungeons:bossbar_invulnerable"
					]
				}
			},
			"dungeons:bossbar_invulnerable": {
				"add": {
					"component_groups": [
						"dungeons:bossbar_invulnerable"
					]
				},
				"remove": {
					"component_groups": [
						"dungeons:bossbar_normal"
					]
				}
			},
			"dungeons:attempt_target_teleport": {
				"trigger": "dungeons:bossbar_invulnerable",
				"set_property": {
					"dungeons:target_teleporting": true
				},
				"stop_movement": {
					"stop_horizontal_movement": true
				}
			},
			"dungeons:try_teleport_random": {},
			"minecraft:entity_transformed": {
				"trigger": "minecraft:entity_spawned"
			},
			"minecraft:entity_spawned": {
				"remove": {},
				"add": {
					"component_groups": [
						"dungeons:bossbar_normal",
						"dungeons:endersent_normal",
						"dungeons:loot_normal"
					]
				}
			},
			"dungeons:spawn_with_eye": {
				"set_property": {
					"dungeons:eye": true
				},
				"add": {
					"component_groups": [
						"dungeons:endersent_normal",
						"dungeons:loot_eye"
