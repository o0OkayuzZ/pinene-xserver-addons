								{
									"test": "is_raider",
									"subject": "other",
									"value": false
								},
								{
									"test": "rider_count",
									"value": 0
								},
								{
									"test": "is_riding",
									"subject": "other",
									"value": false
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "enchantable"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "enchanted",
									"operator": "!="
								}
							]
						},
						"max_dist": 32,
						"must_see": true
					},
					{
						"filters": {
							"all_of": [
								{
									"test": "is_raider",
									"subject": "other",
									"value": true
								},
								{
									"test": "rider_count",
									"value": 0
								},
								{
									"test": "is_riding",
									"subject": "other",
									"value": false
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "enchantable"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "enchanted",
									"operator": "!="
								}
							]
						},
						"max_dist": 128,
						"must_see": false
					}
				]
			},
			"minecraft:behavior.look_at_player": {
				"priority": 9,
				"look_distance": 3,
				"probability": 1
			},
			"minecraft:behavior.look_at_entity": {
				"priority": 10,
				"look_distance": 8,
				"filters": {
					"test": "is_family",
					"subject": "other",
					"value": "mob"
				}
			},
			"minecraft:behavior.equip_item": {
				"priority": 4
			},
			"minecraft:behavior.pickup_items": {
