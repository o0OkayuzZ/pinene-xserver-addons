			"minecraft:persistent": {},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:follow_range": {
				"value": 64
			},
			"minecraft:can_join_raid": {},
			"minecraft:conditional_bandwidth_optimization": {}
		},
		"events": {
			"dungeons:begin_casting": {
				"set_property": {
					"dungeons:casting": true
				}
			},
			"dungeons:complete_casting": {
				"set_property": {
					"dungeons:casting": false
				},
				"queue_command": {
					"command": [
						"tag @s remove dungeons:enchanting_detected"
					]
				}
			},
			"minecraft:spawn_for_raid": {
				"add": {
					"component_groups": [
						"minecraft:raid_configuration",
						"minecraft:raid_despawn",
						"minecraft:raid_persistence"
					]
				}
			},
			"minecraft:start_celebrating": {
				"sequence": [
					{
						"add": {
							"component_groups": [
								"minecraft:celebrate"
							]
						}
					},
					{
						"filters": {
							"test": "has_nametag",
							"value": false
						},
						"remove": {
							"component_groups": [
								"minecraft:raid_persistence"
							]
						}
					}
				]
			},
			"minecraft:stop_celebrating": {
				"remove": {
					"component_groups": [
						"minecraft:celebrate"
					]
				}
			},
			"minecraft:raid_expired": {
				"sequence": [
					{
						"filters": {
							"test": "has_nametag",
							"value": false
						},
						"remove": {
							"component_groups": [
								"minecraft:raid_persistence"
							]
						}
					}
				]
			}
		}
