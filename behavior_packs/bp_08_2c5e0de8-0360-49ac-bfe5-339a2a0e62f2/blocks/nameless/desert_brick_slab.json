{
	"format_version": "1.21.120",
	"minecraft:block": {
		"description": {
			"identifier": "dungeons:desert_brick_slab",
			"menu_category": {
				"category": "construction",
				"group": "minecraft:itemGroup.name.slab"
			},
			"traits": {
				"minecraft:placement_position": {
					"enabled_states": [
						"minecraft:vertical_half"
					]
				}
			},
			"states": {
				"dungeons:double": [
					false,
					true
				]
			}
		},
		"permutations": [
			{
				"condition": "q.block_state('minecraft:vertical_half') == 'bottom' && !q.block_state('dungeons:double')",
				"components": {
					"minecraft:precipitation_interactions": {
						"precipitation_behavior": "none"
					},
					"dungeons:slab_interact": {},
					"minecraft:liquid_detection": {
						"detection_rules": [
							{
								"can_contain_liquid": true,
								"stops_liquid_flowing_from_direction": [
									"down"
								]
							}
						]
					},
					"minecraft:collision_box": {
						"origin": [
							-8,
							0,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					},
					"minecraft:selection_box": {
						"origin": [
							-8,
							0,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:vertical_half') == 'top' && !q.block_state('dungeons:double')",
				"components": {
					"dungeons:slab_interact": {},
					"minecraft:liquid_detection": {
						"detection_rules": [
							{
								"can_contain_liquid": true,
								"stops_liquid_flowing_from_direction": [
									"down"
								]
							}
						]
					},
					"minecraft:collision_box": {
						"origin": [
							-8,
							8,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					},
					"minecraft:selection_box": {
						"origin": [
							-8,
							8,
							-8
						],
						"size": [
							16,
							8,
							16
						]
					}
				}
			},
			{
				"condition": "q.block_state('dungeons:double')",
				"components": {
					"dungeons:slab_destroy": {},
					"minecraft:liquid_detection": {
						"detection_rules": [
							{
								"can_contain_liquid": false
							}
						]
					},
					"minecraft:geometry": "minecraft:geometry.full_block"
				}
			}
		],
		"components": {
			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 6
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 5,
				"item_specific_speeds": [
					{
						"item": {
							"tags": "query.any_tag('minecraft:is_pickaxe')"
						},
						"destroy_speed": 1.5
					}
				]
			},
			"minecraft:geometry": {
				"identifier": "geometry.dungeons_slab",
				"bone_visibility": {
					"bottom_slab": "q.block_state('minecraft:vertical_half') == 'bottom'",
					"top_slab": "q.block_state('minecraft:vertical_half') == 'top'"
				}
			},
			"tag:pickaxe_mine": {},
			"tag:minecraft:is_pickaxe_item_destructible": {},
			"minecraft:material_instances": {
				"*": {
					"texture": "desert_bricks"
				}
			}
		}
	}
}