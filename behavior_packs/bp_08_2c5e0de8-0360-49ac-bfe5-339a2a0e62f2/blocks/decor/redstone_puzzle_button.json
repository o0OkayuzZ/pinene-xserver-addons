{
  "format_version": "1.21.130",
  "minecraft:block": {
    "description": {
      "identifier": "dungeons:redstone_puzzle_button",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "dungeons:pressed": [false, true],
        "dungeons:section": [1, 2, 3, 4]
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('dungeons:pressed')",
        "components": {
          "dungeons:redstone_puzzle_button_pressed": {
            "on_sound": "click_on.nether_wood_button",
            "off_sound": "click_off.nether_wood_button"
          },
          "minecraft:tick": {
            "looping": true,
            "interval_range": [15, 15]
          },
          "minecraft:selection_box": {
            "origin": [-6.5, 0, -6.5],
            "size": [13, 4, 13]
          }
        }
      },
      {
        "condition": "!q.block_state('dungeons:pressed')",
        "components": {
          "minecraft:selection_box": {
            "origin": [-6.5, 0, -6.5],
            "size": [13, 2.5, 13]
          }
        }
      }
    ],
    "components": {
      "minecraft:collision_box": {
        "origin": [-6.5, 0, -6.5],
        "size": [13, 2, 13]
      },
      "minecraft:selection_box": {
        "origin": [-6.5, 0, -6.5],
        "size": [13, 4, 13]
      },
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:precipitation_interactions": {
        "precipitation_behavior": "obstruct_rain"
      },
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["all"]
          }
        ]
      },
      "dungeons:redstone_puzzle_button": {
        "on_sound": "click_on.nether_wood_button",
        "off_sound": "click_off.nether_wood_button"
      },
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_explosion": false,
      "minecraft:geometry": {
        "identifier": "geometry.puzzle_button",
        "bone_visibility": {
          "unpressed": "query.block_state('dungeons:pressed')",
          "pressed": "!query.block_state('dungeons:pressed')"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "render_method": "alpha_test",
          "texture": "chiseled_stone_bricks"
        }
      },
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true,
            "liquid_type": "water"
          }
        ]
      },
      "minecraft:map_color": "#E896F9",
      "minecraft:destructible_by_mining": false
    }
  }
}
