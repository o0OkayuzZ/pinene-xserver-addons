{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "pinene:meitetsu_chest",
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ]
        }
      },
      "menu_category": {
        "category": "construction"
      }
    },
    "components": {
      "minecraft:geometry": "geometry.meitetsu_chest",
      "minecraft:material_instances": {
        "*": {
          "texture": "pinene:meitetsu_chest"
        }
      },
      "minecraft:item_visual": {
        "geometry": "geometry.meitetsu_chest_item",
        "material_instances": {
          "*": {
            "texture": "pinene:meitetsu_chest",
            "render_method": "alpha_test"
          }
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2.5
      },
      "minecraft:destructible_by_explosion": false,
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:map_color": "#2b2b33",
      "minecraft:selection_box": {
        "origin": [-7, 0, -7],
        "size": [14, 14, 14]
      },
      "minecraft:collision_box": {
        "origin": [-7, 0, -7],
        "size": [14, 14, 14]
      },
      "minecraft:loot": "loot_tables/blocks/meitetsu_chest.json"
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      }
    ]
  }
}
