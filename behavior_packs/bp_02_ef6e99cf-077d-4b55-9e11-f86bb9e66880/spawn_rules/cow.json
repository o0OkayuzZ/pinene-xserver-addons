{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "minecraft:cow",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": "minecraft:grass",
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:weight": {
          "default": 20
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        },
        "minecraft:permute_type": [
          {
            "weight": 84,
            "entity_type": "cow"
          },
          {
            "weight": 15,
            "entity_type": "a:applecow"
          },
          {
            "weight": 1,
            "entity_type": "a:gapplecow"
          }
        ],
        "minecraft:biome_filter": {
          "test": "has_biome_tag",
          "operator": "==",
          "value": "animal"
        }
      },
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:weight": {
          "default": 15
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:permute_type": [
          {
            "weight": 100,
            "entity_type": "a:tcow"
          }
        ],
        "minecraft:biome_filter": {
          "all_of": {
            "all_of": [
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "roofed"
              },
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "dark_oak"
              }
            ]
          }
        }
      }
    ]
  }
}