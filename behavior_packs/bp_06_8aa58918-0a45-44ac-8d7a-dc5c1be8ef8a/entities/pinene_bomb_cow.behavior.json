      "is_experimental": false,
      "spawn_egg": {
        "texture": "spawn_egg_cow"
      },
      "properties": {
        "myname:is_fusing": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "myname:blink_on": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["cow", "animal", "mob"]
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.4
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 6,
        "must_see": true,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "wheat"
                }
              ]
            },
            "max_dist": 16.0
          }
        ]
      },
      "minecraft:behavior.breed": {
        "priority": 3,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "items": ["wheat"],
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.follow_parent": {
        "priority": 5,
        "speed_multiplier": 1.1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 1.2,
        "outside_range": 2.0,
        "must_see": false,
        "on_inside_range": {
          "event": "myname:auto_start_fuse",
          "target": "self"
        },
        "on_outside_range": {
          "event": "myname:stop_fuse",
          "target": "self"
        },
        "on_vision_lost_inside_range": {
          "event": "myname:stop_fuse",
          "target": "self"
        }
      },
      "minecraft:explode": {
        "fuse_length": [7.5, 7.5],
        "fuse_lit": false,
        "power": 6.0,
        "causes_fire": false,
        "destroy_affected_by_griefing": true
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "domain": "hand",
                    "subject": "other",
                    "value": "bucket:0"
                  }
                ]
              }
            },
            "use_item": true,
            "transform_to_item": "bucket:1",
            "play_sounds": "milk",
            "interact_text": "action.interact.milk"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "domain": "hand",
                    "subject": "other",
                    "value": "wheat"
                  },
                  {
                    "test": "is_baby",
                    "subject": "self",
                    "value": false
                  }
                ]
              },
              "event": "minecraft:become_love",
              "target": "self"
            },
            "use_item": true,
            "play_sounds": "eat",
            "interact_text": "action.interact.feed"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "domain": "hand",
                    "subject": "other",
                    "value": "wheat:0"
                  },
                  {
                    "test": "is_baby",
                    "subject": "self",
                    "value": false
                  }
                ]
              },
              "event": "minecraft:become_love",
              "target": "self"
            },
            "use_item": true,
            "play_sounds": "eat",
            "interact_text": "action.interact.feed"
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "domain": "hand",
                    "subject": "other",
                    "value": "flint_and_steel"
                  }
                ]
              },
              "event": "myname:start_fuse",
              "target": "self"
            },
            "use_item": false,
            "play_sounds": "ignite"
          }
        ]
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "Math.Random(1,3)"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/cow.json"
      },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": ["wheat"],
        "breeds_with": [
          {
            "mate_type": "myname:pinene_bomb_cow",
            "baby_type": "myname:pinene_bomb_cow"
          }
        ]
      },
      "minecraft:ageable": {
        "duration": 1200,
        "feed_items": ["wheat"]
      },
      "minecraft:behavior.move_towards_target": {
        "priority": 10,
        "speed_multiplier": 1.25,
        "within_radius": 2.5
      }
    },
    "component_groups": {
      "fuse_lit": {
        "minecraft:explode": {
          "fuse_length": [7.5, 7.5],
          "fuse_lit": true,
          "power": 6.0,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "fuse_audio": {
        "minecraft:ambient_sound_interval": {
          "event_name": "ambient",
          "range": 1.0
        }
      },
      "fuse_hiss_command": {
        "minecraft:timer": {
          "looping": true,
          "time": [0.07, 0.09],
          "time_down_event": {
            "event": "myname:fuse_hiss_tick",
            "target": "self"
          }
        }
      },
      "fuse_visual": {
        "minecraft:timer": {
          "looping": true,
          "time": [0.14, 0.22],
          "time_down_event": {
            "event": "myname:fuse_visual_tick",
            "target": "self"
          }
        }
      },
      "fuse_blink_timer": {
        "minecraft:timer": {
          "looping": true,
          "time": [0.15, 0.15],
          "time_down_event": {
            "event": "myname:blink_toggle",
            "target": "self"
          }
        }
      }
    },
    "events": {
      "myname:auto_start_fuse": {
        "sequence": [
          {
            "filters": {
              "none_of": [
                {
                  "test": "has_equipment",
                  "domain": "hand",
                  "subject": "other",
                  "value": "wheat"
                },
                {
                  "test": "has_equipment",
                  "domain": "hand",
                  "subject": "other",
                  "value": "wheat:0"
                }
              ]
            },
            "set_property": {
              "myname:is_fusing": true,
              "myname:blink_on": true
            },
            "add": {
              "component_groups": ["fuse_lit", "fuse_audio", "fuse_hiss_command", "fuse_visual", "fuse_blink_timer"]
            }
          }
        ]
      },
      "myname:start_fuse": {
        "queue_command": {
          "command": [
            "playsound mob.creeper.say @a[r=48] ~ ~ ~ 1.35 0.6"
          ]
        },
        "set_property": {
          "myname:is_fusing": true,
          "myname:blink_on": true
        },
        "add": {"component_groups": ["fuse_lit", "fuse_audio", "fuse_hiss_command", "fuse_visual", "fuse_blink_timer"]}
      },
      "myname:fuse_hiss_tick": {
        "queue_command": {
          "command": [
            "playsound mob.creeper.say @a[r=48] ~ ~ ~ 1.05 0.55"
          ]
        }
      },
      "myname:blink_toggle": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "domain": "myname:blink_on",
              "operator": "==",
              "value": true
            },
            "set_property": {
              "myname:blink_on": false
            }
          },
          {
            "filters": {
              "test": "bool_property",
              "domain": "myname:blink_on",
              "operator": "==",
              "value": false
            },
            "set_property": {
              "myname:blink_on": true
            }
          }
        ]
      },
      "myname:fuse_visual_tick": {
        "queue_command": {
          "command": [
            "particle minecraft:basic_flame_particle ~ ~1.0 ~",
            "particle minecraft:basic_smoke_particle ~ ~1.1 ~"
          ]
        }
      },
      "myname:stop_fuse": {
        "set_property": {
          "myname:is_fusing": false,
          "myname:blink_on": false
        },
        "remove": {"component_groups": ["fuse_lit", "fuse_audio", "fuse_hiss_command", "fuse_visual", "fuse_blink_timer"]}
      }
    }
  }
}
