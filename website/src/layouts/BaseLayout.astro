---
import '../styles/global.css';
import { withBase } from '../lib/data';
import { site } from '../site.config';
interface Props { title?: string; description?: string; current?: string }
const { title, description = site.description, current = '' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['ホーム', '/', 'home'], ['コンテンツ', '/contents/', 'contents'], ['図鑑', '/database/', 'database'], ['更新情報', '/updates/', 'updates']];
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="ja_JP"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(withBase('/images/og.png'), Astro.site)}/><meta property="og:image:alt" content="PINE SERVERの仮風景イラスト"/><link rel="icon" type="image/svg+xml" href={withBase('/images/pine.svg')}/></head>
<body>
<a class="skip-link" href="#main">本文へスキップ</a>
<header class="site-header"><div class="header-inner">
  <a class="brand" href={withBase('/')} aria-label="PINE SERVER ホーム"><img src={withBase('/images/pine.svg')} width="32" height="40" alt=""/><span>PINE SERVER<small>EXPLORE. DISCOVER. PLAY.</small></span></a>
  <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false" type="button">メニュー <span aria-hidden="true">☰</span></button>
  <nav id="main-nav" aria-label="メインナビゲーション">{nav.map(([label, href, key]) => <a href={withBase(href)} aria-current={current === key ? 'page' : undefined}>{label}</a>)}<a class="button header-cta" href={withBase('/start/')} aria-current={current === 'start' ? 'page' : undefined}>参加方法を見る <span aria-hidden="true">↗</span></a></nav>
</div></header>
<main id="main" tabindex="-1"><slot/></main>
<footer class="site-footer"><div class="shell footer-main"><a class="brand" href={withBase('/')}><img src={withBase('/images/pine.svg')} width="32" height="40" alt=""/><span>PINE SERVER<small>遊びの、その先へ。</small></span></a><nav aria-label="フッターナビゲーション"><a href={withBase('/start/')}>参加方法・ご案内</a><a href={withBase('/packs/')}>パック情報</a><a href={withBase('/updates/')}>更新情報</a></nav></div><div class="shell footer-note">コミュニティ運営のMinecraftサーバーです。Mojang/Microsoftの公式サイトではありません。</div></footer>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav = document.querySelector<HTMLElement>('#main-nav');
function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); });
document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
nav?.addEventListener('click', event => { if ((event.target as HTMLElement).closest('a')) closeMenu(); });
matchMedia('(min-width: 960px)').addEventListener('change', closeMenu);
document.querySelectorAll<HTMLImageElement>('img').forEach(img => {
  const fallback = () => { img.hidden = true; img.parentElement?.classList.add('image-unavailable'); };
  img.addEventListener('error', fallback); if (img.complete && !img.naturalWidth) fallback();
});
</script>
</body></html>