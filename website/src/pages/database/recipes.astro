---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { entries } from '../../lib/guide';
---
<BaseLayout title="レシピ図鑑" current="database"><section class="page-hero"><div class="shell"><p class="eyebrow">MAKE YOUR NEXT DISCOVERY</p><h1>材料から、新しい道具へ。</h1><p class="lede">確認できた作業台レシピを、材料・配置・完成数とともに紹介します。ゲーム内でのクラフト動作は未確認です。</p></div></section><section class="section"><div class="shell"><div class="guide-grid">{entries.filter(entry=>entry.kind==='recipe').map(entry=><GuideCard entry={entry}/>)}</div></div></section></BaseLayout>