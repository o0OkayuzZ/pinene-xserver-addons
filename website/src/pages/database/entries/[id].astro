---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { entries, entryMap, kindLabels } from '../../../lib/guide';
import { contentMap, withBase } from '../../../lib/data';
export function getStaticPaths() { return entries.map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const owner = contentMap.get(entry.contentId)!;
const recipes = entries.filter(candidate => candidate.recipe?.resultId === entry.id);
const result = entry.recipe ? entryMap.get(entry.recipe.resultId) : null;
const index = entry.kind === 'recipe' ? '/database/recipes/' : '/database/items/';
---
<BaseLayout title={entry.name} description={entry.summary} current="database">
 <section class="page-hero"><div class="shell"><nav class="breadcrumbs" aria-label="パンくず"><a href={withBase('/database/')}>図鑑</a><span>/</span><a href={withBase(index)}>{entry.kind === 'recipe' ? 'レシピ' : 'アイテム・小さな機能'}</a><span>/</span><span>{entry.name}</span></nav><p class="eyebrow">{owner.name} / {kindLabels[entry.kind]}</p><h1>{entry.name}</h1><p class="lede">{entry.summary}</p><span class="status">コード上の設定を確認 / ゲーム内動作は未確認</span></div></section>
 <section class="section"><div class="shell detail-grid"><div>
 <article class="panel"><h2>どんなもの？</h2><p>{entry.description}</p></article>
 <article class="panel"><h2>使い方</h2><p>{entry.usage}</p></article>
 <article class="panel"><h2>入手方法・利用条件</h2><p>{entry.obtaining}</p>{recipes.length > 0 && <ul>{recipes.map(recipe => <li><a class="text-link" href={withBase(`/database/entries/${recipe.id}/`)}>{recipe.name} →</a></li>)}</ul>}</article>
 {entry.details.length > 0 && <article class="panel"><h2>確認できた設定</h2><p class="caption">以下はコードに設定された値です。本番の効果・表示を検証した結果ではありません。</p><ul>{entry.details.map(detail => <li>{detail}</li>)}</ul></article>}
 {entry.recipe && <article class="panel"><h2>材料と配置</h2><p>{entry.recipe.shaped ? '作業台で、次の相対配置に並べる設定です。表の外側のマスは空欄です。左右反転などの受付条件はゲーム内で未確認です。' : '作業台で材料を配置自由に組み合わせる設定です。'}</p><ul>{entry.recipe.ingredients.map(item => <li>{item.name} × {item.count}</li>)}</ul>{entry.recipe.shaped && <div class="table-wrap"><table class="craft-grid"><caption>レシピの配置</caption><tbody>{entry.recipe.grid.map(row => <tr>{row.map(cell => <td>{cell || '空欄'}</td>)}</tr>)}</tbody></table></div>}<p>完成数：{entry.recipe.count}個</p>{result && <a class="text-link" href={withBase(`/database/entries/${result.id}/`)}>{result.name}の説明 →</a>}</article>}
 {entry.contentId === 'mycology' && <p class="section-note">ここで紹介する効果・使い方はゲーム内の設定です。現実のキノコの食用判断には使えません。</p>}
 </div><aside>{entry.image && <figure class="item-portrait"><img src={withBase(entry.image.src)} alt={`${entry.name}のパック内アイテム画像`} width="160" height="160"/><figcaption class="caption">パック内のアイテム画像。ゲーム内での表示は未確認です。</figcaption></figure>}<div class="panel"><h2>所属コンテンツ</h2><a class="text-link" href={withBase(`/contents/${owner.id}/`)}>{owner.name} →</a><a class="text-link" href={withBase(`/database/items/?content=${owner.id}`)}>同じコンテンツの項目を見る →</a></div><div class="panel"><h2>確認状況</h2><p>アイテム・レシピの定義や処理を読んで説明しています。サーバーでの提供、入手、操作、表示は未確認です。</p></div></aside></div></section>
</BaseLayout>
