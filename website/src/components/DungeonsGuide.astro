---
import GuideCard from './GuideCard.astro';
import { entries } from '../lib/guide';
import { withBase } from '../lib/data';
import sections from '../data/dungeons-guide.json';
const groups = sections.map(section => ({ ...section, items: section.entries.flatMap(id => {
  const entry = entries.find(item => item.id === id && item.contentId === 'minecraft-dungeons');
  return entry ? [entry] : [];
}) })).filter(section => section.items.length);
const total = entries.filter(entry => entry.contentId === 'minecraft-dungeons').length;
---
<section class="section dungeons-guide" aria-labelledby="dungeons-guide-title">
 <div class="shell">
  <p class="eyebrow">GEAR UP FOR YOUR NEXT ADVENTURE</p>
  <h2 id="dungeons-guide-title">次の冒険は、どの装備で？</h2>
  <p class="lede">画像で選び、使い道を調べ、材料をそろえる。Dungeonsの図鑑{total}項目を種類別に紹介します。</p>
  <nav class="dungeons-nav" aria-label="Dungeonsの種類別一覧">
   {groups.map(group => <a href={`#dungeons-${group.id}`}>{group.title} <span>{group.items.length}</span></a>)}
  </nav>
  <div class="dungeons-start panel">
   <h3>はじめの一歩は、英雄の書から。</h3>
   <p>本1冊と金インゴット4個で、収集の手がかりを用意しよう。道具を作りたいときは、ダイヤモンドの粉のレシピへ。</p>
   <div class="hero-actions"><a class="button" href={withBase('/database/entries/book-of-heroes-recipe/')}>英雄の書を作る</a><a class="text-link" href={withBase('/database/entries/dungeons-diamond-dust-recipe/')}>素材のレシピを見る →</a></div>
  </div>
  {groups.map(group => <section id={`dungeons-${group.id}`} class="dungeons-group" aria-labelledby={`dungeons-title-${group.id}`}>
   <h3 id={`dungeons-title-${group.id}`}>{group.title} <small>{group.items.length}件</small></h3>
   <p>{group.intro}</p>
   <div class="guide-grid">{group.items.slice(0,4).map(entry => <GuideCard entry={entry}/>)}</div>
   {group.items.length > 4 && <details class="dungeons-more"><summary>{group.title}の残り{group.items.length-4}件を見る</summary><div class="guide-grid">{group.items.slice(4).map(entry => <GuideCard entry={entry}/>)}</div></details>}
  </section>)}
  <p class="caption">アイテム画像はパック内の素材です。説明は現行コードを照合したもので、戦闘性能・操作・表示の実機確認は引き続き行う必要があります。</p>
  <a class="button" href={withBase('/database/items/?content=minecraft-dungeons')}>Dungeonsの図鑑を検索する</a>
 </div>
</section>
<style>
 .dungeons-guide{background:#e9ece3}
 .dungeons-nav{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.5rem 0 2rem}
 .dungeons-nav a{background:#fff;border:2px solid #262d22;padding:.65rem .8rem;font-weight:800;text-decoration:none;color:#222}
 .dungeons-nav span{margin-left:.5rem;color:#446c31}
 .dungeons-start{border-left:6px solid #548837}
 .dungeons-group{scroll-margin-top:6rem;margin:3rem 0}
 .dungeons-group h3{font-size:clamp(1.35rem,3vw,2rem);margin-bottom:.4rem}
 .dungeons-group h3 small{font-size:.85rem;color:#526346;white-space:nowrap}
 .dungeons-more{margin-top:1rem;border:2px solid #bcc5b2;background:#f6f7f2}
 .dungeons-more summary{cursor:pointer;padding:1rem;font-weight:800}
 .dungeons-more[open] .guide-grid{padding:0 1rem 1rem}
 .dungeons-more summary:focus-visible{outline:3px solid #3b6d20;outline-offset:3px}
 @media(max-width:600px){.dungeons-nav a{flex:1 1 43%;font-size:.85rem}.dungeons-more[open] .guide-grid{padding:0 .5rem .5rem}}
</style>
