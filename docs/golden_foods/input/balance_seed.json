  "science_ui": {
    "carrot": {
      "title_gold": "視覚とビタミンA",
      "title_enchanted": "視覚増強",
      "body": "β-カロテンはビタミンAの前駆体。ビタミンA由来のレチナールは、暗所視に関わるロドプシンの構成に必要です。",
      "caveat": "不足のない人が大量に食べても、超人的な視力が得られるわけではありません。",
      "sources": [
        "S1"
      ]
    },
    "potato": {
      "title_gold": "グリコーゲンローディング",
      "title_enchanted": "グリコーゲン超充填",
      "body": "デンプンは消化されてグルコースになります。その一部は肝臓や筋肉にグリコーゲンとして蓄えられ、必要に応じて利用されます。",
      "caveat": "パンにも同じ糖質代謝があります。ジャガイモだけが貯蔵されるという意味ではありません。",
      "sources": [
        "S2",
        "S3"
      ]
    },
    "beetroot": {
      "title_gold": "NOブースト",
      "title_enchanted": "NOオーバードライブ",
      "body": "食事由来の硝酸塩は、口腔内細菌などの働きで亜硝酸塩となり、さらに一酸化窒素（NO）へ変換されます。NOは血管の弛緩に関わります。",
      "pathway": "NO3- → NO2- → NO",
      "caveat": "運動への影響は条件によって異なります。速度上昇や再生の数値はゲーム用の創作です。",
      "sources": [
        "S5",
        "S6"
      ]
    },
    "melon": {
      "title_gold": "ハイドレーション",
      "title_enchanted": "ハイパーハイドレーション",
      "body": "水分は体温調節などに必要です。スイカに含まれるシトルリンはアルギニンへ変換され、アルギニンは一酸化窒素（NO）を作る材料になります。",
      "caveat": "水分補給やシトルリンに、炎・溶岩を無効化する作用はありません。",
      "sources": [
        "S5",
        "S7"
      ]
    },
    "pumpkin": {
      "title_gold": "生体防御",
      "title_enchanted": "生体防御亢進",
      "body": "カボチャなどに含まれるβ-カロテンはビタミンAの前駆体。ビタミンAは上皮組織の維持や、正常な免疫機能に必要です。",
      "caveat": "食べた直後の耐性上昇や毒・衰弱の短縮は、ゲーム上の誇張です。",
      "sources": [
        "S1"
      ]
    },
    "poison": {
      "title_gold": "解毒応答",
      "title_enchanted": "異物代謝オーバードライブ",
      "body": "ジャガイモの芽や緑化した部分などには、ソラニン・チャコニンが多く含まれることがあります。これらは食中毒の原因になります。",
      "caveat": "毒で回復するのはゲーム内だけです。現実では食べて耐性をつけようとせず、加熱だけで安全になるとも考えないでください。",
      "sources": [
        "S8"
      ]
    },
    "bread": {
