{
  "format_version": "1.8.0",
  "animations": {
    "animation.pinene_sans.idle": {
      "loop": true,
      "animation_length": 2,
      "bones": {
        "body": {
          "position": [
            0,
            "math.sin(query.life_time * 120) * 0.11",
            0
          ],
          "rotation": [
            "query.property('pinene_sans:tired') * -5",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            0,
            "math.sin(query.life_time * 45) * 2",
            "math.sin(query.life_time * 60) * 1.2"
          ]
        },
        "magic_eye": {
          "scale": "query.property('pinene_sans:casting') ? 1.0 : 0.0"
        },
        "pupil": {
          "scale": "query.property('pinene_sans:casting') ? 0.0 : 1.0"
        }
      }
    },
    "animation.pinene_sans.bone": {
      "loop": true,
      "bones": {
        "root": {
          "scale": [
            1,
            "query.property('pinene_sans:height')",
            1
          ]
        }
      }
    },
    "animation.pinene_sans.blaster": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "-22 * (1 - ((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival'))))) + 360 * (query.property('pinene_sans:departure'))",
            0,
            "math.sin(query.life_time * 80) * 1.5 - 18 * (1 - ((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival')))))"
          ],
          "position": [
            0,
            "-8 * (1 - ((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival'))))) + 7 * math.sin((query.property('pinene_sans:departure')) * 180) + 4 * (query.property('pinene_sans:departure'))",
            "14 * (1 - ((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival'))))) + 18 * (query.property('pinene_sans:departure'))"
          ],
          "scale": "(0.03 + 0.97 * ((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival')))) + 0.40 * math.sin(((query.property('pinene_sans:arrival') * query.property('pinene_sans:arrival') * (3 - 2 * query.property('pinene_sans:arrival')))) * 180)) * (1 - (query.property('pinene_sans:departure')) * (query.property('pinene_sans:departure')))"
        },
        "jaw": {
          "rotation": [
            "query.property('pinene_sans:firing') ? -46 : (query.property('pinene_sans:departure') > 0 ? -4 - 42 * math.max(0, 1 - query.property('pinene_sans:departure') * 3) : -4)",
            0,
            0
          ],
          "position": [
            0,
            "math.sin(query.life_time * 140) * 0.55",
            "query.property('pinene_sans:recoil') * 2.8"
          ]
        },
        "skull": {
          "rotation": [
            "query.property('pinene_sans:firing') ? 10 : (query.property('pinene_sans:departure') > 0 ? 10 * math.max(0, 1 - query.property('pinene_sans:departure') * 3) : 0)",
            0,
            0
          ],
          "position": [
            0,
            "math.sin(query.life_time * 140) * 0.55",
            "query.property('pinene_sans:recoil') * 2.8"
          ]
        },
        "core": {
          "scale": "query.property('pinene_sans:firing') ? 1.0 : 0.0"
        }
      }
    }
  }
}
