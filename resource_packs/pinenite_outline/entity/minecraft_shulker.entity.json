      },
      "render_controllers": [
        "controller.render.shulker",
        {
          "controller.render.pinenite_outline.minecraft_shulker_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ]
    }
