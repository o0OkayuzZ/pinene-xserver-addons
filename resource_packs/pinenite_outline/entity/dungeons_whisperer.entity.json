{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:whisperer",
      "min_engine_version": "1.10.0",
      "materials": {
        "default": "entity_emissive_alpha",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/whisperer/whisperer"
      },
      "geometry": {
        "default": "geometry.whisperer",
        "pn_outline_default": "geometry.pinenite_outline.geometry_whisperer"
      },
      "scripts": {
        "animate": [
          "look_at_target",
          "idle",
          "move_controller",
          "summon_controller"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ]
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "summon_controller": "controller.animation.necromancer.cast",
        "cast": "animation.whisperer.summon",
        "move_controller": "controller.animation.whisperer.move",
        "move": "animation.whisperer.move",
        "idle": "animation.whisperer.idle"
      },
      "render_controllers": [
        "controller.render.default",
        {
          "controller.render.pinenite_outline.dungeons_whisperer_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "egg_whisperer"
      }
    }
  }
}
