{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:enchanted_watchling",
      "min_engine_version": "1.10.0",
      "materials": {
        "default": "enderman",
        "invisible": "enderman_invisible",
        "enchanted": "dungeons_entity_enchant",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/enchanted_mob/watchling",
        "enchanted": "textures/misc/enchanted_entity_glint"
      },
      "geometry": {
        "default": "geometry.watchling",
        "pn_outline_default": "geometry.pinenite_outline.geometry_watchling"
      },
      "particle_effects": {
        "particle": "dungeons:enderling_vfx",
        "teleport": "dungeons:instant_teleport"
      },
      "scripts": {
        "animate": [
          "move",
          "bob",
          "attack_controller",
          "teleport_controller"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ]
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "move": "animation.watchling.move",
        "attack.rotations": "animation.watchling.attack",
        "bob": "animation.watchling.bob",
        "particles": "animation.watchling.particles",
        "temp_teleport": "animation.watchling.temp_teleport",
        "attack_controller": "controller.animation.redstone_golem.attack",
        "teleport_controller": "controller.animation.watchling.teleport"
      },
      "render_controllers": [
        "controller.render.enderling",
        "controller.render.dungeons_entity_enchanted",
        {
          "controller.render.pinenite_outline.dungeons_enchanted_watchling_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        },
        {
          "controller.render.pinenite_outline.dungeons_enchanted_watchling_1": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "egg_enchanted_watchling"
      }
    }
  }
}
