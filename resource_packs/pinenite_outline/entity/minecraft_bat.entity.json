{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:bat",
      "materials": {
        "default": "bat_v2",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/bat_v2"
      },
      "geometry": {
        "default": "geometry.bat_v2",
        "pn_outline_default": "geometry.pinenite_outline.geometry_bat_v2"
      },
      "scripts": {
        "scale": "1.0",
        "animate": [
          "pn_legacy_move"
        ]
      },
      "animations": {
        "resting": "animation.bat.resting",
        "flying": "animation.bat.flying",
        "pn_legacy_move": "controller.animation.bat.move"
      },
      "render_controllers": [
        "controller.render.bat",
        {
          "controller.render.pinenite_outline.minecraft_bat_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_bat"
      }
    }
  }
}
