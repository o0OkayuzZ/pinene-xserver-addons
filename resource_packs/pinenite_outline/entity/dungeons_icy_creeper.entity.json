{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:icy_creeper",
      "min_engine_version": "1.10.0",
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "dungeons_entity_enchant",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/creeper/icy_creeper",
        "charged": "textures/entity/creeper/creeper_charged",
        "glint": "textures/misc/charged_glint",
        "empty": "textures/misc/void"
      },
      "geometry": {
        "default": "geometry.icy_creeper",
        "pn_outline_default": "geometry.pinenite_outline.geometry_icy_creeper"
      },
      "spawn_egg": {
        "texture": "egg_icy_creeper"
      },
      "scripts": {
        "pre_animation": [
          "variable.wobble = Math.sin(query.swell_amount * 5730) * query.swell_amount * 0.01 + 1.0;",
          "variable.swelling_scale1 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.4 + 1.0) * variable.wobble;",
          "variable.swelling_scale2 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.1 + 1.0) / variable.wobble;",
          "variable.leg_rot = Math.cos(query.modified_distance_moved * 38.17326) * 80.22 * query.modified_move_speed;",
          "variable.flash = Math.mod(Math.Round(query.swell_amount * 10.0), 2.0);"
        ],
        "animate": [
          {
            "charged_particles": "q.is_powered"
          },
          "particles",
          "creeper_head_controller",
          "creeper_legs_controller",
          "creeper_swelling_controller"
        ]
      },
      "particle_effects": {
        "frost_particle": "dungeons:frost_particle",
        "charge_particle": "dungeons:thundering"
      },
      "animations": {
        "creeper_head": "animation.common.look_at_target",
        "particles": "animation.icy_creeper.particles",
        "creeper_legs": "animation.creeper.legs",
        "creeper_swelling": "animation.creeper.swelling",
        "creeper_head_controller": "controller.animation.creeper.head",
        "creeper_legs_controller": "controller.animation.creeper.legs",
        "creeper_swelling_controller": "controller.animation.creeper.swelling",
        "charged_particles": "animation.icy_creeper.charge_particles"
      },
      "render_controllers": [
        "controller.render.creeper",
        "controller.render.creeper_charged",
        {
          "controller.render.pinenite_outline.dungeons_icy_creeper_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        },
        {
          "controller.render.pinenite_outline.dungeons_icy_creeper_1": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ]
    }
  }
}
