{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:xp_orb",
      "materials": {
        "default": "experience_orb",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/experience_orb"
      },
      "geometry": {
        "default": "geometry.experience_orb",
        "pn_outline_default": "geometry.pinenite_outline.geometry_experience_orb"
      },
      "animations": {
        "face_player": "animation.actor.billboard"
      },
      "scripts": {
        "scale": "0.3",
        "pre_animation": [
          "variable.u = Math.mod(query.texture_frame_index, 4) * 16.0 / 64.0;",
          "variable.v = math.round(query.texture_frame_index / 4) * 16.0 / 64.0;"
        ],
        "animate": [
          "face_player"
        ]
      },
      "render_controllers": [
        "controller.render.experience_orb",
        {
          "controller.render.pinenite_outline.minecraft_xp_orb_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ]
    }
  }
}
