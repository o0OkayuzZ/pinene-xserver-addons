{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:polar_bear",
      "materials": {
        "default": "polar_bear",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/polar_bear",
        "baby": "textures/entity/polar_bear/polar_bear_baby"
      },
      "geometry": {
        "default": "geometry.polarbear",
        "baby": "geometry.polar_bear.baby",
        "pn_outline_default": "geometry.pinenite_outline.geometry_polarbear",
        "pn_outline_baby": "geometry.pinenite_outline.geometry_polar_bear_baby"
      },
      "animations": {
        "walk": "animation.quadruped.walk",
        "move": "animation.polarbear.move",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.polarbear.baby_transform",
        "pn_legacy_move": "controller.animation.polar_bear.move"
      },
      "scripts": {
        "scale": "query.is_baby ? 2.0 : 1.2",
        "animate": [
          "pn_legacy_move"
        ]
      },
      "render_controllers": [
        "controller.render.polar_bear.v2",
        {
          "controller.render.pinenite_outline.minecraft_polar_bear_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_polar_bear"
      }
    }
  }
}
