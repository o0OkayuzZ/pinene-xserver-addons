{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:snareling",
      "min_engine_version": "1.10.0",
      "materials": {
        "default": "entity_emissive_alpha",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/snareling/snareling"
      },
      "geometry": {
        "default": "geometry.snareling",
        "pn_outline_default": "geometry.pinenite_outline.geometry_snareling"
      },
      "particle_effects": {
        "particle": "dungeons:snareling_vfx"
      },
      "scripts": {
        "animate": [
          "look_at_target",
          "particles",
          "move_controller",
          "bob",
          "attack_controller"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ]
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "attack_controller": "controller.animation.snareling.attack",
        "move_controller": "controller.animation.blastling.move",
        "move": "animation.blastling.move",
        "move_arms": "animation.blastling.move_arms",
        "bob": "animation.watchling.bob",
        "particles": "animation.watchling.particles",
        "attack": "animation.snareling.attack",
        "shoot": "animation.snareling.spit"
      },
      "render_controllers": [
        "controller.render.default",
        {
          "controller.render.pinenite_outline.dungeons_snareling_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "egg_snareling"
      }
    }
  }
}
