{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:soul_wizard",
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "dungeons_entity_enchant",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/soul_wizard/soul_wizard",
        "glow": "textures/entity/enchanted_mob/soul_wizard",
        "enchanted": "textures/misc/enchanted_entity_glint"
      },
      "geometry": {
        "default": "geometry.soul_wizard",
        "pn_outline_default": "geometry.pinenite_outline.geometry_soul_wizard"
      },
      "particle_effects": {
        "glow": "dungeons:soul_wizard_glow"
      },
      "spawn_egg": {
        "texture": "egg_soul_wizard"
      },
      "scripts": {
        "animate": [
          "base_controller",
          "look_at_target",
          "particles"
        ]
      },
      "animations": {
        "particles": "animation.guardian_vex.particles",
        "look_at_target": "animation.common.look_at_target",
        "idle": "animation.soul_wizard.idle",
        "shoot": "animation.soul_wizard.shoot",
        "move": "animation.soul_wizard.fly",
        "base_controller": "controller.animation.soul_wizard.general"
      },
      "render_controllers": [
        "controller.render.soul_wizard",
        {
          "controller.render.dungeons_entity_enchanted": "q.is_saddled==1"
        },
        {
          "controller.render.pinenite_outline.dungeons_soul_wizard_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        },
        {
          "controller.render.pinenite_outline.dungeons_soul_wizard_1": "(q.is_saddled==1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ]
    }
  }
}
