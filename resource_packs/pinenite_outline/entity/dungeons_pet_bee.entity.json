{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:pet_bee",
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "dungeons_entity_enchant",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/bee/bee",
        "angry": "textures/entity/bee/bee_angry",
        "nectar": "textures/entity/bee/bee_nectar",
        "angry_nectar": "textures/entity/bee/bee_angry_nectar",
        "glow": "textures/entity/enchanted_mob/bee",
        "enchanted": "textures/misc/enchanted_entity_glint"
      },
      "geometry": {
        "default": "geometry.bee",
        "pn_outline_default": "geometry.pinenite_outline.geometry_bee"
      },
      "animations": {
        "flying": "animation.bee.flying",
        "drip": "controller.animation.bee.drip",
        "controller_bee_sting": "controller.animation.bee.sting",
        "bee_sting": "animation.bee.sting",
        "bee_no_stinger": "animation.bee.no_stinger",
        "bee_fly_bobbing": "animation.bee.fly.bobbing",
        "bee_root_controller": "controller.animation.bee.root"
      },
      "particle_effects": {
        "nectar_dripping": "minecraft:nectar_drip_particle"
      },
      "scripts": {
        "animate": [
          "bee_root_controller",
          {
            "bee_no_stinger": "query.mark_variant==1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.dungeons_bee",
        {
          "controller.render.dungeons_entity_enchanted": "q.is_saddled==1"
        },
        {
          "controller.render.pinenite_outline.dungeons_pet_bee_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        },
        {
          "controller.render.pinenite_outline.dungeons_pet_bee_1": "(q.is_saddled==1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "base_color": "#F6C344",
        "overlay_color": "#2B2118"
      }
    }
  }
}
