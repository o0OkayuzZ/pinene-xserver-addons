{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:wildfire",
      "materials": {
        "default": "entity_alphatest",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/wildfire/wildfire2"
      },
      "geometry": {
        "default": "geometry.wildfire2",
        "pn_outline_default": "geometry.pinenite_outline.geometry_wildfire2"
      },
      "particle_effects": {
        "smoke": "dungeons:wildfire_smoke",
        "slam": "dungeons:wildfire_slam"
      },
      "spawn_egg": {
        "texture": "egg_wildfire"
      },
      "scripts": {
        "animate": [
          "smoke",
          "look_at_target",
          "spin",
          {
            "death": "query.is_alive!=1"
          }
        ]
      },
      "animations": {
        "smoke": "animation.wildfire.smoke",
        "shockwave": "animation.wildfire2.slam",
        "spin": "animation.wildfire2.spin",
        "death": "animation.wildfire2.death",
        "look_at_target": "animation.common.look_at_target"
      },
      "render_controllers": [
        "controller.render.wildfire",
        {
          "controller.render.pinenite_outline.dungeons_wildfire_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ]
    }
  }
}
