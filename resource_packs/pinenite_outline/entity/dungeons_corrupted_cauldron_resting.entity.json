{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:corrupted_cauldron_resting",
      "materials": {
        "default": "entity_emissive_alpha",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/corrupted_cauldron/off",
        "on": "textures/entity/corrupted_cauldron/on"
      },
      "geometry": {
        "default": "geometry.corrupted_cauldron",
        "pn_outline_default": "geometry.pinenite_outline.geometry_corrupted_cauldron"
      },
      "render_controllers": [
        "controller.render.redstone_monstrosity",
        {
          "controller.render.pinenite_outline.dungeons_corrupted_cauldron_resting_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "animations": {
        "resting": "animation.corrupted_cauldron.inactive",
        "awaken": "animation.corrupted_cauldron.activate",
        "wake_controller": "controller.animation.redstone_monstrosity.rest"
      },
      "scripts": {
        "animate": [
          "wake_controller"
        ]
      },
      "sound_effects": {
        "awaken": "mob.corrupted_cauldron.awaken"
      },
      "particle_effects": {
        "bubble": "dungeons:cauldron_bubble",
        "base_flame": "dungeons:cauldron_base"
      },
      "spawn_egg": {
        "texture": "egg_corrupted_cauldron"
      }
    }
  }
}
