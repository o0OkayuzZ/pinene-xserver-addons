{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:salmon",
      "materials": {
        "default": "salmon",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/fish/salmon"
      },
      "geometry": {
        "default": "geometry.salmon",
        "pn_outline_default": "geometry.pinenite_outline.geometry_salmon"
      },
      "scripts": {
        "pre_animation": [
          "variable.ZRot = !query.is_in_water ? Math.cos((query.time_stamp + query.frame_alpha) * 14.32) * 90 : 0.0;",
          "variable.AnimationAmountBlend = Math.lerp(variable.AnimationAmountPrev, variable.AnimationAmount, query.frame_alpha);"
        ],
        "animate": [
          "pn_legacy_general"
        ]
      },
      "animations": {
        "flop": "animation.salmon.flop",
        "swim": "animation.salmon.swim",
        "pn_legacy_general": "controller.animation.fish.general"
      },
      "render_controllers": [
        "controller.render.salmon",
        {
          "controller.render.pinenite_outline.minecraft_salmon_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_salmon"
      }
    }
  }
}
