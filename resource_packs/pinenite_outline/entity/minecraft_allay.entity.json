{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:allay",
      "materials": {
        "default": "allay",
        "pn_outline": "pinenite_outline"
      },
      "textures": {
        "default": "textures/entity/allay/allay"
      },
      "geometry": {
        "default": "geometry.allay",
        "pn_outline_default": "geometry.pinenite_outline.geometry_allay"
      },
      "spawn_egg": {
        "texture": "spawn_egg_allay"
      },
      "scripts": {
        "pre_animation": [
          "variable.holding_trident = query.is_item_name_any('slot.weapon.mainhand', 'minecraft:trident');"
        ],
        "animate": [
          "pn_legacy_general",
          "pn_legacy_look_at_target",
          "pn_legacy_holding",
          "pn_legacy_dancing"
        ]
      },
      "animations": {
        "idle": "animation.allay.idle",
        "fly": "animation.allay.fly",
        "hold_item": "animation.allay.hold_item",
        "dance": "animation.allay.dance",
        "hold_item_fly": "animation.allay.hold_item_fly",
        "look_at_target_default": "animation.allay.look_at_target.default",
        "pn_legacy_general": "controller.animation.allay.general",
        "pn_legacy_look_at_target": "controller.animation.allay.look_at_target",
        "pn_legacy_holding": "controller.animation.allay.holding",
        "pn_legacy_dancing": "controller.animation.allay.dancing"
      },
      "render_controllers": [
        "controller.render.allay",
        {
          "controller.render.pinenite_outline.minecraft_allay_0": "(1) && ((variable.pinenite_outline ?? 0) > 0 && query.life_time < (variable.pinenite_outline_until ?? 0))"
        }
      ],
      "enable_attachables": true,
      "held_item_ignores_lighting": true
    }
  }
}
