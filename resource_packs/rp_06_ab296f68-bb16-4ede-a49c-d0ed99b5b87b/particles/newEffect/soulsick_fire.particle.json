{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dungeons:soulsick_fire",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/soulsick_flame"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.2, 0],
				"radius": "1.15 * v.radius",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.clamp(1.1*(0.4 + v.height/2.5), 0.3, 1.5)"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 3, 0],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1 + v.particle_random_1/10", "0.1 + v.particle_random_1/10"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 4,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [1, 1],
						"step_UV": [0, 1],
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			}
		}
	}
}
