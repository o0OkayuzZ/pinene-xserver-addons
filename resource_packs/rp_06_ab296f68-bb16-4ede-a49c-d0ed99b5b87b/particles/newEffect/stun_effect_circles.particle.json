{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dungeons:stun_effect_circles",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/stun"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.1, 0],
				"radius": 0.5,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(v.particle_random_2/3 )+0.8"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": 180
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 2.5, 0],
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.1+v.particle_random_1)/5", "(0.1+v.particle_random_1)/5"],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF3400",
						"1.0": "#FFFFF800"
					}
				}
			}
		}
	}
}