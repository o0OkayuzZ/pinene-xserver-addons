{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dungeons:shockwave_melee_stars",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/forceglow_particles"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0.78,
					1,
					0.83
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "100+(v.emitter_age*40)",
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 0.77
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					"(0.1+v.emitter_age)*15*v.direction_x*v.emitter_age",
					"(0.1+v.emitter_age)*15*v.direction_y*v.emitter_age",
					"(0.1+v.emitter_age)*15*v.direction_z*v.emitter_age"
				],
				"radius": "v.emitter_age*5",
				"direction": [
					"v.direction_x*math.random(-0.5,1)",
					0.5,
					"v.direction_z*math.random(-0.5,1)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.4
			},
			"minecraft:particle_initial_speed": "1+v.particle_random_1*4",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.25-v.particle_age/2",
					"0.25-v.particle_age/2"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [
							0,
							11
						],
						"size_UV": [
							1,
							1
						],
						"step_UV": [
							1,
							0
						],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"1.0": "#FF7FDFFF"
					}
				}
			}
		}
	}
}