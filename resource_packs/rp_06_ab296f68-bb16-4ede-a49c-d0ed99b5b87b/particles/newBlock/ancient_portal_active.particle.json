{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dungeons:ancient_portal_active",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/forceglow_particles"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "5 + v.emitter_random_1*5",
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "(3 + v.particle_random_1*3) -1"
			},
			"minecraft:particle_expire_if_in_blocks": ["dungeons:ancient_portal", "minecraft:obsidian", "dungeons:ancient_portal_frame", "dungeons:spawner_obsidian", "dungeons:gilded_obsidian", "minecraft:crying_obsidian"],
			"minecraft:particle_initial_speed": "(7 + v.emitter_random_1*5)/v.particle_lifetime",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-1,1)/2", "math.random(-1,1)/2", "math.random(-1,1)/2"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size*(0.2 + v.particle_random_2/10)", "v.size*(0.2 + v.particle_random_2/10)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["math.floor(v.particle_random_4*4)", 0],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF5D00FF",
						"0.5": "#FFD000FF",
						"1.0": "#FF9600FF"
					}
				}
			}
		}
	}
}