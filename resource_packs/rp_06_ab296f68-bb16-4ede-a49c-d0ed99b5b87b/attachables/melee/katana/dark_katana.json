{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:dark_katana",
			"render_controllers": [
				"controller.render.item_default"
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/weapon/dark_katana",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.dark_katana"
			},
			"animations": {
				"first_person_hold": "animation.katana.first_person_hold",
				"third_person_hold": "animation.katana.third_person_hold",
				"melee_attack": "animation.sword.first_person_swing",
				"melee_controller": "controller.animation.weapon.melee_attack"
			},
			"scripts": {
				"initialize": [
					"v.melee_attack = false;"
				],
				"pre_animation": [
					"q.get_name == (t.player_name ?? '') ? {v.melee_attack = t.melee_attack;};"
				],
				"animate": [
					{
						"melee_controller": "c.is_first_person"
					},
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}