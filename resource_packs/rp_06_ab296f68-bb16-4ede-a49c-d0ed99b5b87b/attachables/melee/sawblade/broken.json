{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:broken_sawblade",
			"render_controllers": [
				"controller.render.animated_sawblade"
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/attachables/broken_sawblade",
				"alt": "textures/items/attachables/broken_sawblade_alt",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.broken_sawblade",
				"alt": "geometry.broken_sawblade_alt"
			},
			"animations": {
				"first_person_hold": "animation.sawblade.first_person_hold",
				"third_person_hold": "animation.sawblade.third_person_hold",
				"melee_attack": "animation.sawblade.first_person_swing",
				"melee_controller": "controller.animation.weapon.melee_attack",
				"use_start":"animation.sawblade.first_person_start_use",
				"use_loop":"animation.sawblade.first_person_loop_use",
				"use_end":"animation.sawblade.first_person_end_use",
				"use_controller": "controller.animation.sawblade.use",
				"cooldown":"animation.sawblade.first_person_cooldown"
			},
			"scripts": {
				"initialize": [
					"v.melee_attack = false;"
				],
				"pre_animation": [
					"q.get_name == (t.player_name ?? '') ? {v.melee_attack = t.melee_attack;};"
				],
				"animate": [
					{
						"cooldown": "c.is_first_person"
					},
					{
						"use_controller": "c.is_first_person"
					},
					{
						"melee_controller": "c.is_first_person"
					},
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}