{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:cackling_broom",
			"render_controllers": [
				"controller.render.item_default"
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/attachables/cackling_broom",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"animations": {
				"first_person": "animation.spear.held_first_person",
				"third_person": "animation.spear.held_third_person",
				"hit": "animation.spear.hit"
			},
			"scripts": {
				"animate": [
					{
						"first_person": "query.is_first_person"
					},
					{
						"third_person": "!query.is_first_person"
					} /*,
                    {
                        "hit": "variable.attack_time"
                    }*/
				],
				"pre_animation": [
					"v.actions_and_stuff = c.owning_entity -> v.actions_and_stuff;"
				],
				"parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_custom_pos = 1; };"
			},
			"geometry": {
				"default": "geometry.spear"
			}
		}
	}
}