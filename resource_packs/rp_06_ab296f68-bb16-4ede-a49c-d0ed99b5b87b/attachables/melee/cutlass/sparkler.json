{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:sparkler",
			"render_controllers": [
				"controller.render.item_default",
				"controller.render.dungeons_sparkler"
			],
			"materials": {
				"default": "entity_alphatest",
				"glow": "entity_emissive_alpha",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/attachables/sparkler_static",
				"glow_1": "textures/items/attachables/sparkler_glow_1",
				"glow_2": "textures/items/attachables/sparkler_glow_2",
				"glow_3": "textures/items/attachables/sparkler_glow_3",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.sparkler_1",
				"glow_1": "geometry.glowing_sparkler_1",
				"glow_2": "geometry.glowing_sparkler_2",
				"glow_3": "geometry.glowing_sparkler_3"
			},
			"animations": {
				"first_person_hold": "animation.sawblade.first_person_hold",
				"third_person_hold": "animation.sawblade.third_person_hold",
				"melee_attack": "animation.sawblade.first_person_swing",
				"melee_controller": "controller.animation.weapon.melee_attack"
			},
			"scripts": {
				"initialize": [
					"v.melee_attack = false;"
				],
				"pre_animation": [
					"q.get_name == (t.player_name ?? '') ? {v.melee_attack = t.melee_attack;};"
				],
				"animate": [
					{
						"melee_controller": "c.is_first_person"
					},
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}