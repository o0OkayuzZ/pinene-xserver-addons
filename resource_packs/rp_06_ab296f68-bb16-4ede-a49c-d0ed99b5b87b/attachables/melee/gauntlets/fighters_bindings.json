{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:fighters_bindings",
			"render_controllers": [
				"controller.render.item_default",
				"controller.render.sawblade_glowing"
			],
			"materials": {
				"default": "entity_alphatest",
				"glow": "entity_emissive_alpha",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/attachables/fighters_bindings_static",
				"glow": "textures/items/attachables/fighters_bindings_glow",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.gauntlets",
				"glow": "geometry.glowing_gauntlets"
			},
			"animations": {
				"first_person_hold": "animation.gauntlets.first_person_hold",
				"third_person_hold": "animation.gauntlets.third_person_hold",
				"melee_attack": "animation.gauntlets.first_person_swing2",
				"melee_controller": "controller.animation.weapon.melee_attack"
			},
			"scripts": {
				"initialize": [
					"v.melee_attack = false;"
				],
				"pre_animation": [
					"q.get_name == (t.player_name ?? '') ? {v.melee_attack = t.melee_attack;};"
				],
				"animate": [
					{
						"melee_controller": "c.is_first_person"
					},
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}