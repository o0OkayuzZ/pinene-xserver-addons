{
  "format_version": "1.20.10",
  "render_controllers": {
    "controller.render.pinene.dungeons_213_crossbow": {
      "arrays": {
        "textures": {
          "array.bow_texture_frames": [
            "texture.bow_standby",
            "texture.bow_pulling_0",
            "texture.bow_pulling_1",
            "texture.bow_pulling_2",
            "texture.bow_ready"
          ]
        },
        "geometries": {
          "array.bow_geo_frames": [
            "geometry.crossbow_standby",
            "geometry.crossbow_pulling_0",
            "geometry.crossbow_pulling_1",
            "geometry.crossbow_pulling_2",
            "geometry.crossbow_ready"
          ]
        }
      },
      "geometry": "array.bow_geo_frames[q.item_is_charged ? 4 : v.charge_amount]",
      "materials": [
        {
          "*": "v.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.bow_texture_frames[q.item_is_charged ? 4 : v.charge_amount]",
        "texture.enchanted"
      ]
    },
    "controller.render.entity_ancient": {
      "geometry": "geometry.default",
      "part_visibility": [
        {
          "*": true
        }
      ],
      "materials": [
        {
          "*": "material.enchanted"
        }
      ],
      "textures": [
        "texture.ancient"
      ],
      "color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "uv_anim": {
        "offset": [
          "(math.floor(query.life_time*20)+query.frame_alpha)*-0.02",
          "(math.floor(query.life_time*20)+query.frame_alpha)*0.03"
        ],
        "scale": [
          1,
          1
        ]
      },
      "light_color_multiplier": 2.5,
      "ignore_lighting": false
    }
  }
}
