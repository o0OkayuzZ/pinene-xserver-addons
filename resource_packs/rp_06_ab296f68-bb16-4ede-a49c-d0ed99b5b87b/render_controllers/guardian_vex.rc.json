{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.guardian_vex": {
			"geometry": "Geometry.default",
			"materials": [ { "*": "Material.default" } ],
        "arrays": {
            "textures": {
              "array.skins": [
                "texture.default",
                "texture.glow"
              ]
          }
      },
      "textures": [ "Array.skins[query.is_saddled]" ],
			"ignore_lighting": true,
    "is_hurt_color" : {
        "r": 1.0,
        "g": 1.0,
        "b": 1.0,
        "a": 0.5
    },
			"overlay_color": {
          "r": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "g": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "b": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "a": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0"
      }
		}
	}
}
