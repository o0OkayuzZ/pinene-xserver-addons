{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.armored_pillager": {
      "geometry": "Array.geo[query.property('dungeons:armour_type')]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('dungeons:armour_type')]"
      ],
      "arrays": {
        "textures": {
          "array.skins": [
            "texture.default",
            "texture.gold",
            "texture.diamond"
          ]
        },
        "geometries": {
          "array.geo": [
            "geometry.default",
            "geometry.armored",
            "geometry.armored"
          ]
        }
      }
    }
  }
}