{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.soul_wizard": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"arrays": {
				"textures": {
					"array.skins": [
						"texture.default",
						"texture.glow"
					]
				}
			},
			"textures": [
				"Array.skins[query.is_saddled]"
			],
			"overlay_color": {
				"r": 0.9,
				"g": 0.95,
				"b": 1.0,
				"a": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0"
			}
		}
	}
}