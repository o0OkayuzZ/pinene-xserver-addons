{
    "format_version": "1.10",
    "render_controllers": {
        "controller.render.creeper_charged": {
            "geometry": "Geometry.default",
            "part_visibility": [
                { "*": true }
            ],
            "materials": [
                { "*": "Material.enchanted" }
            ],
            "arrays": {
            "textures": {
              "array.skins": [
                "texture.empty",
                "texture.glint"
              ]
          }
      },
      "textures": [ "Array.skins[query.is_powered]" ],
            "color": {
                "r": 0.5,
                "g": 0.0,
                "b": 1.0,
                "a": 1.0
            },
            "uv_anim": {
                "offset": [
                    "(Math.floor(query.life_time * 20.0) + query.frame_alpha) * -0.02",
                    "(Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.03"
                ],
                "scale": [
                    1.0,
                    1.0
                ]
            },
            "light_color_multiplier": 1.5,
            "ignore_lighting": false
        }
    }
}