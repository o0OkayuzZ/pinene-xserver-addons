{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ooze": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ],
      "ignore_lighting": true
    },
    "controller.render.ooze_armor": {
      "geometry": "Geometry.armor",
      "materials": [ { "*": "Material.outer" } ],
      "textures": [ "Texture.default" ],
      "ignore_lighting": true,
	"overlay_color": {
          "r": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "g": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "b": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
          "a": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0"
      }
    }
  }
}
