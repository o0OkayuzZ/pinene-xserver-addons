{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.redstone_monstrosity": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
        "arrays": {
            "textures": {
              "array.skins": [
                "texture.default",
                "texture.on"
              ]
          }
      },
      "textures": [ "Array.skins[query.variant]" ]
    },
    "controller.render.monstrosity_redstone": {
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": ["Texture.redstone"],
      "ignore_lighting": true
    },
    "controller.render.monstrosity_awaken": {
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
        "arrays": {
            "textures": {
              "array.skins": [
                "texture.none",
                "texture.redstone"
              ]
          }
      },
      "textures": [ "Array.skins[query.variant]" ],
      "ignore_lighting": true
    }
  }
}
