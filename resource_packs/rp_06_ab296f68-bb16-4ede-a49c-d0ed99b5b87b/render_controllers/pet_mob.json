{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.pet_mob_dungeons": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"arrays": {
				"textures": {
					"array.skins": [
						"texture.default",
						"texture.glow"
					]
				}
			},
			"textures": [
				"Array.skins[query.is_saddled]"
			]
		},
		"controller.render.pet_llama_dungeons": {
			"part_visibility": [
				{
					"chest*": "query.is_chested"
				}
			],
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"arrays": {
				"textures": {
					"array.skins": [
						"texture.default",
						"texture.glow"
					]
				}
			},
			"textures": [
				"Array.skins[query.is_saddled]"
			]
		}
	}
}