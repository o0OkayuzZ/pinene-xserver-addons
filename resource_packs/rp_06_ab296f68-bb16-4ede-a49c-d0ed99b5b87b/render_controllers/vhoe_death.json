{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.vengeful_heart_of_ender_death": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": [
        "q.has_property('dungeons:spooky') ? q.property('dungeons:spooky') ? Texture.costume : Texture.default : Texture.default"
      ],
      "overlay_color": {
        "r": "(q.life_time/2) >= 2 ? (q.life_time/2)-2 : 0",
        "g": "(q.life_time/2) >= 2 ? (q.life_time/2)-2 : 0",
        "b": "(q.life_time/2) >= 2 ? (q.life_time/2)-2 : 0",
        "a": "(q.life_time/2) >= 2 ? (q.life_time/2)-2 : 0"
      }
    }
  }
}
