{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.animated_sawblade": {
      "arrays": {
        "textures": {
          "array.skins": [
            "texture.default",
            "texture.alt"
          ]
        },
        "geometries": {
          "array.geo": [
            "Geometry.default",
            "Geometry.alt"
          ]
        }
      },
      "geometry": "q.is_using_item ? array.geo[math.mod(q.life_time*12, 2)] : q.cooldown_time_remaining('sawblade') > 0 ? array.geo[math.mod(q.life_time*2, 2)] : array.geo[math.mod(q.life_time*8, 2)]",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "q.is_using_item ? array.skins[math.mod(q.life_time*12, 2)] : q.cooldown_time_remaining('sawblade') > 0 ? array.skins[math.mod(q.life_time*2, 2)] : array.skins[math.mod(q.life_time*8, 2)]"
      ]
    }
  }
}