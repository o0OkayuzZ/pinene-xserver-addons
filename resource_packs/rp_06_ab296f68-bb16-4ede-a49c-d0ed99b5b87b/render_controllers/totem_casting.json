{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.totem_casting": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["texture.default"],
      "ignore_lighting": true,
      "is_hurt_color": {
        "r": 0.9,
        "g": 0.9,
        "b": 1.0,
        "a": 0.5
      },
      "overlay_color": {
        "r": "q.life_time <= 1.6 ? 0.9 - (q.life_time/1.6) : 0",
        "g": "q.life_time <= 1.6 ? 0.9 - (q.life_time/1.6) : 0",
        "b": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0",
        "a": "q.life_time <= 1.6 ? 1.0 - (q.life_time/1.6) : 0"
      }
    }
  }
}