{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.vindicator_vanilla": {
      "geometry": "Geometry.default",
      "part_visibility": [
        { "rightArm": "query.is_angry || query.is_celebrating" },
        { "leftArm": "query.is_angry || query.is_celebrating" },
        { "rightItem": "query.is_angry" },
        { "arms": "!(query.is_angry || query.is_celebrating)" }
      ],
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ]
    },
    "controller.render.vindicator": {
      "geometry":  "Array.geo[query.skin_id]",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Array.skins[query.skin_id]" ],
      "part_visibility": [
        { "rightArm": "query.is_angry || query.is_celebrating" },
        { "leftArm": "query.is_angry || query.is_celebrating" },
        { "rightItem": "query.is_angry" },
        { "arms": "!(query.is_angry || query.is_celebrating)" }
      ],
        "arrays": {
            "textures": {
              "array.skins": [
                "texture.default",
                "texture.gold",
                "texture.diamond"
              ]
          },
            "geometries": {
              "array.geo": [
                "geometry.default",
                "geometry.armored",
              "geometry.armored"
              ]
          }
      }
    }
  }
}
