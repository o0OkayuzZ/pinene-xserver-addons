{
    "format_version": "1.10",
    "render_controllers": {
        "controller.render.entity_guard": {
            "geometry": "Geometry.default",
            "part_visibility": [
                { "*": true }
            ],
            "materials": [
                { "*": "Material.enchanted" }
            ],
            "textures": [
                "Texture.guard"
            ],
            "color": {
                "r": 1.0,
                "g": 1.0,
                "b": 1.0,
                "a": 1.0
            },
            "uv_anim": {
                "offset": [
                    "(Math.floor(query.life_time * 20.0) + query.frame_alpha) * -0.02",
                    "(Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.03"
                ],
                "scale": [
                    1.0,
                    1.0
                ]
            },
            "light_color_multiplier": 1.7,
            "ignore_lighting": false
        }
    }
}