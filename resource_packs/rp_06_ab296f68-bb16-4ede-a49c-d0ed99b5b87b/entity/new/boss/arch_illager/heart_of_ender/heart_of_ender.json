{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "dungeons:heart_of_ender",
			"materials": {
				"default": "entity_alphablend",
				"glow": "entity_emissive_alpha",
				"stars": "dungeons_entity_enchant"
			},
			"spawn_egg": {
				"texture": "egg_heart_of_ender"
			},
			"textures": {
				"default": "textures/entity/arch_illager/heart_of_ender",
				"glow": "textures/entity/arch_illager/heart_of_ender_glow",
				"stars": "textures/misc/heart_of_ender_stars"
			},
			"geometry": {
				"default": "geometry.heart_of_ender",
				"glow": "geometry.heart_of_ender"
			},
			"render_controllers": [
				"controller.render.heart_of_ender",
				"controller.render.heart_of_ender.glow",
				"controller.render.heart_of_ender.stars"
			],
			"sound_effects": {
				"rise": "mob.heart_of_ender.rise",
				"sink": "mob.heart_of_ender.sink",
				"walk": "mob.heart_of_ender.walk",
				"loop": "mob.heart_of_ender.loop",
				"loop_laser": "mob.heart_of_ender.loop_laser"
			},
			"particle_effects": {
				"smoke": "dungeons:heart_of_ender_smoke"
			},
			"animations": {
				"hidelaser": "animation.heart_of_ender.laser1_hidden",
				"idle": "animation.heart_of_ender.idle",
				"walk": "animation.heart_of_ender.walk",
				"move_controller": "controller.animation.heart_of_ender.move",
				"particles": "animation.heart_of_ender.smoke_particles",
				"summon": "animation.heart_of_ender.bombs",
				"summon_controller": "controller.animation.heart_of_ender.summon",
				"look_at_target": "animation.common.look_at_target",
				"look_at_target_controller": "controller.animation.heart_of_ender.look_at_target",
				"idle_spinning": "animation.heart_of_ender.idle_spinning_lasers",
				"spinning_lasers": "controller.animation.heart_of_ender.spinning_lasers",
				"loopsound": "animation.heart_of_ender.loopsound",
				"loopsound_laser": "animation.heart_of_ender.loopsound_laser"
			},
			"scripts": {
				"scale": "q.property('dungeons:hidden') ? 0 : 1",
				"animate": [
					"look_at_target_controller",
					"summon_controller",
					"hidelaser",
					"move_controller",
					"spinning_lasers",
					"loopsound",
					{
						"particles": "q.property('dungeons:hidden')==false"
					},
					{
						"loopsound_laser": "q.property('dungeons:spinning_lasers')==true"
					}
				]
			}
		}
	}
}