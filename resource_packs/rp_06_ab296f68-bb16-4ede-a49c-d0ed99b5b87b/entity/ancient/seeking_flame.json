{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:seeking_flame",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "entity_emissive_alpha",
                "enchanted": "dungeons_entity_enchant"
            
      },
      "textures": {
        "default": "textures/entity/enchanted_mob/vex",
        "charging": "textures/entity/enchanted_mob/vex_charging",
                "enchanted": "textures/misc/ancient_entity_glint"
      },
      "geometry": {
        "default": "geometry.vex.v1.8"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.empty_handed  = !query.is_item_equipped(0) && !query.is_item_equipped(1);"
        ],
        "scale": "1.0"
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "vex_charge": "animation.vex.charge",
        "vex_idle": "animation.vex.idle"
      },
      "animation_controllers": [
        {
          "look_at_target": "controller.animation.humanoid.look_at_target"
        },
        {
          "vex_charge": "controller.animation.vex.charge"
        },
        {
          "vex_idle": "controller.animation.vex.idle"
        }
      ],
      "render_controllers": [
        "controller.render.vex",
        "controller.render.dungeons_entity_ancient"
      ],
      "held_item_ignores_lighting": true
    }
  }
}