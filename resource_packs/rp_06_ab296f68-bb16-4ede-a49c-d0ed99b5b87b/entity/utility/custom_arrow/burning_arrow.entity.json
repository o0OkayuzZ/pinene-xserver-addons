{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:burning_arrow",
      "materials": {
        "default": "arrow"
      },
      "textures": {
        "default": "textures/entity/arrows/burning_arrow"
      },
      "geometry": {
        "default": "geometry.arrow"
      },
      "animations": {
        "move": "animation.arrow.move",
        "particles": "animation.necromancer_shot.particles"
      },
      "particle_effects": {
           "energy": "dungeons:burning_arrow_trail"
	    },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ],
        "animate": [
          {"particles": "!q.is_on_ground && !q.is_in_water_or_rain"},
          "move"
        ]
      },
      "render_controllers": [ "controller.render.burning_arrow" ]
    }
  }
}
