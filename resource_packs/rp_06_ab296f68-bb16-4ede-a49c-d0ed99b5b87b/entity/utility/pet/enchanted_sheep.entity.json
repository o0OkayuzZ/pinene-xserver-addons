{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:enchanted_sheep",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "entity_emissive",
        "enchanted": "dungeons_entity_enchant"
      },
      "textures": {
        "default": "textures/entity/enchanted_sheep/red",
        "green": "textures/entity/enchanted_sheep/green",
        "blue": "textures/entity/enchanted_sheep/blue",
        "red_enchanted": "textures/entity/enchanted_mob/sheep_red",
        "green_enchanted": "textures/entity/enchanted_mob/sheep_green",
        "blue_enchanted": "textures/entity/enchanted_mob/sheep_blue",
        "enchanted": "textures/misc/enchanted_entity_glint"
      },
      "geometry": {
        "default": "geometry.enchanted_sheep"
      },
      "animations": {
        "setup": "animation.sheep.setup",
        "grazing": "animation.quadruped.walk",
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.sheep.baby_transform",
        "move": "controller.animation.sheep.move"
      },
      "scripts": {
        "animate": [
          "setup",
          "look_at_target",
          "move",
          {
            "baby_transform": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.enchanted_sheep",
        {
          "controller.render.dungeons_entity_enchanted": "q.is_saddled==1"
        }
      ],
      "spawn_egg": {
        "base_color": "#E8E8E8",
        "overlay_color": "#7B3CFF"
      }
    }
  }
}
