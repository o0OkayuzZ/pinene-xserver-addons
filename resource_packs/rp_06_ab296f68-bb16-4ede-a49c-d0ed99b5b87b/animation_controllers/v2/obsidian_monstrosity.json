{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.obsidian_monstrosity.attack": {
			"initial_state": "default",
			"states": {
				"attacking": {
					"animations": [
						"attack_main"
					],
					"transitions": [
						{
							"default": "!query.is_delayed_attacking"
						}
					],
					"blend_transition": 0
				},
				"attacking_2": {
					"animations": [
						"attack_alt"
					],
					"transitions": [
						{
							"default": "!query.is_delayed_attacking"
						}
					],
					"blend_transition": 0
				},
				"default": {
					"transitions": [
						{
							"attacking": "query.is_delayed_attacking&&math.random(0,1)<0.5"
						},
						{
							"attacking_2": "query.is_delayed_attacking&&math.random(0,1)>=0.5"
						}
					],
					"blend_transition": 0
				}
			}
		}
	}
}