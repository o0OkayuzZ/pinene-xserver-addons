{
	"format_version": "1.8.0",
	"animations": {
		"animation.player.draw_bow": {
			"loop": true,
			"bones": {
				"rightArm": {
					"rotation": [
						"v.is_first_person?0:(q.head_x_rotation(0)+-72.5)+(v.tcos0*0.5)",
						"v.is_first_person?0:q.head_y_rotation(0)-q.body_y_rotation(0)",
						0
					]
				},
				"leftArm": {
					"rotation": [
						"v.is_first_person?0:(q.head_x_rotation(0)+-90)-v.tcos0",
						"v.is_first_person?0:25+(q.head_y_rotation(0)-q.body_y_rotation(0))",
						0
					],
					"position": [
						"v.is_first_person?0:-1",
						0,
						"v.is_first_person?0:-1"
					]
				}
			}
		},
		"animation.player.load_crossbow": {
			"loop": true,
			"bones": {
				"rightArm": {
					"rotation": [
						"v.is_first_person?0:(q.head_x_rotation(0)+-72.5)+(v.tcos0*0.5)+(q.is_riding?15:0)",
						"v.is_first_person?0:q.head_y_rotation(0)-q.body_y_rotation(0)",
						0
					]
				},
				"leftArm": {
					"rotation": [
						"v.is_first_person?0:(q.head_x_rotation(0)+-90)-(v.tcos0*(q.is_item_equipped(1)?0.5:1))+(q.is_riding?15:0)",
						"v.is_first_person?0:25+(q.head_y_rotation(0)-q.body_y_rotation(0))",
						0
					],
					"position": [
						"v.is_first_person?0:-1",
						0,
						"v.is_first_person?0:-1"
					]
				}
			}
		},
		"animation.player.hold_crossbow": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.3,
			"bones": {
				"leftarm": {
					"rotation": [
						"query.is_swimming?0:-93+query.target_x_rotation-query.is_sneaking*27-this",
						"query.is_swimming?0:42+math.clamp(query.target_y_rotation,-45,5)-this",
						"query.is_sneaking*-15"
					]
				},
				"rightarm": {
					"rotation": [
						"query.is_swimming?0:-93+query.target_x_rotation-query.is_sneaking*27-this",
						"query.is_swimming?0:math.clamp(query.target_y_rotation,-60,45)-this",
						0
					]
				}
			}
		},
		"animation.arrow.scale": {
			"loop": false,
			"animation_length": 0.5,
			"bones": {
				"body": {
					"scale": "query.property('dungeons:scale')/10"
				}
			}
		},
		"animation.player.dual_crossbows_hold": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.3,
			"bones": {
				"leftarm": {
					"rotation": [
						"(v.is_first_person?0:-variable.tcos0)+(v.is_first_person?0:-68.5)",
						0,
						"v.is_first_person?0:17.5"
					]
				},
				"rightarm": {
					"rotation": [
						"(v.is_first_person?0:-55.5)+(v.is_first_person?0:variable.tcos0/2)",
						0,
						"v.is_first_person?0:-9"
					]
				}
			}
		}
	}
}