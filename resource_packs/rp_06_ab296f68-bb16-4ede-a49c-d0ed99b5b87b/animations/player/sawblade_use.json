						"v.is_first_person ? 0.0 : 17.5"
					]
				},
				"rightItem": {
					"rotation": ["-v.is_first_person ? 0.0 : 7.5", "-v.is_first_person ? 0.0 : 15", "v.is_first_person ? -0.0 : 25"],
